# Singha Auctions backend — environment template. Copy to `.env` for local dev.
# On Railway, set these in the service's Variables (NEVER commit real secrets).
NODE_ENV=production
LOG_LEVEL=info
# Railway injects PORT; API_PORT is the local fallback.
API_PORT=4000

# --- Supabase Postgres ---
# URL-encode password specials (# -> %23, @ -> %40); append ?sslmode=require.
DATABASE_URL=
# Direct (non-pooled) connection for Prisma migrations.
DIRECT_URL=

# --- Supabase project (SERVER-ONLY keys) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=singha-media

# --- Auth / CORS ---
JWT_SECRET=
SESSION_SECRET=
# Allowed web origins ('*' reflects any; set to your Vercel URL in prod).
CORS_ORIGINS=*
# Passwordless demo login (email -> bidder token). Set false for real production.
DEMO_AUTH_ENABLED=true

# --- Optional: Redis for the worker (BullMQ). Leave blank to run API only. ---
REDIS_URL=

DEFAULT_CURRENCY=LKR
DEFAULT_LOCALE=en
