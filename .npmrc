# Phase 0 pragmatic defaults (see docs/generated/DECISIONS.md — D-0007).
# shamefully-hoist keeps a flat, predictable node_modules so every workspace
# package resolves shared tooling (typescript, vitest, @types/*) without having
# to redeclare it everywhere. Tighten to strict isolation in a later hardening pass.
shamefully-hoist=true
auto-install-peers=true
strict-peer-dependencies=false
# Corepack pins the exact pnpm version via package.json "packageManager".
