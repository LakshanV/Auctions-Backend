// Singha Auctions V2 — Phase 0 stable data core.
// Non-negotiable rules (docs/04): permanent records survive app rewrites; IDs are
// opaque ULIDs minted by the app; audit + financial history is append-only;
// original media is immutable; integration is via a transactional outbox.
//
// Scope of this schema = Phase 0 foundations only: identity, inventory, media
// provenance, audit, outbox and platform config. Later phases add auction, EOI,
// commerce, live, etc. via ADDITIVE migrations (expand-migrate-verify-contract).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations — Supabase pooler-safe.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CustomerStatus {
  prospect
  active
  suspended
  closed
}

enum KycStatus {
  none
  pending
  verified
  rejected
}

enum ChannelType {
  web
  whatsapp
  facebook
  instagram
  email
  sms
}

enum OrgRole {
  owner
  admin
  staff
}

enum AssetLifecycle {
  draft
  in_intake
  available
  reserved
  sold
  withdrawn
  archived
}

enum SaleMethod {
  TIMED_AUCTION
  EXPRESSION_OF_INTEREST
  BUY_NOW
  MAKE_OFFER
  SEALED_TENDER
  LIVE_HYBRID
}

enum ListingStatus {
  draft
  submitted
  review
  changes_required
  approved
  scheduled
  live
  ended
  sold
  unsold
  withdrawn
}

enum MediaKind {
  image
  video
  document
  video_thumbnail
}

enum MediaStatus {
  uploading
  processing
  ready
  failed
  archived
}

enum ActorType {
  customer
  staff
  system
  ai
}

enum OutboxStatus {
  pending
  dispatched
  failed
}

// ---------------------------------------------------------------------------
// Identity (docs/05) — verified facts only; AI intelligence lives elsewhere.
// ---------------------------------------------------------------------------

model Customer {
  id              String         @id
  status          CustomerStatus @default(prospect)
  // Human-readable, immutable, never-recycled Client ID (e.g. CUS-000001),
  // generated by an atomic DB sequence — NOT the primary key (Revision 05 §10/§3).
  clientReference String?        @unique @map("client_reference")
  legalName       String?        @map("legal_name")
  email           String?        @unique
  phone           String?        @unique
  kycStatus       KycStatus      @default(none) @map("kyc_status")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  externalIdentities   ExternalIdentity[]
  organizationMembers  OrganizationMember[]
  ownedAssets          Asset[]
  memberships          Membership[]
  accessGrants         MembershipAccessGrant[]
  securityInstruments  SecurityInstrument[]
  creditFacilities     CreditFacility[]
  creditReservations   CreditReservation[]
  performanceEvents    PerformanceEvent[]
  performanceSnapshots PerformanceSnapshot[]
  memberFlags          MemberFlag[]
  discoveryEvents      DiscoveryEvent[]
  buyerTwin            BuyerTwinProjection?

  @@map("customer")
}

// External channel identities NEVER replace customer_id (docs/05).
model ExternalIdentity {
  id         String      @id
  customerId String      @map("customer_id")
  channel    ChannelType
  externalId String      @map("external_id")
  verifiedAt DateTime?   @map("verified_at")
  createdAt  DateTime    @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([channel, externalId])
  @@index([customerId])
  @@map("external_identity")
}

model Organization {
  id                    String   @id
  legalName             String   @map("legal_name")
  publicRef             String   @unique @map("public_ref")
  // Durable, human-readable Organization reference (e.g. ORG-000001), separate
  // atomic sequence from Customer Client IDs (Revision 05 §10).
  organizationReference String?  @unique @map("organization_reference")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  members             OrganizationMember[]
  sellerAssets        Asset[]
  sellerSales         Sale[]
  securityInstruments SecurityInstrument[]

  @@map("organization")
}

model OrganizationMember {
  id             String   @id
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  role           OrgRole  @default(staff)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@unique([organizationId, customerId])
  @@index([customerId])
  @@map("organization_member")
}

// ---------------------------------------------------------------------------
// Inventory & media (docs/04, docs/06) — Asset is enduring; Listing is a sale
// attempt; original media is immutable, derivatives carry provenance.
// ---------------------------------------------------------------------------

model Asset {
  id                   String         @id
  category             String
  schemaVersion        Int            @default(1) @map("schema_version")
  // Category-specific attributes, validated against the versioned category
  // schema (docs/06). Nullable + additive so pre-existing assets stay valid.
  attributes           Json?
  lifecycle            AssetLifecycle @default(draft)
  ownerCustomerId      String?        @map("owner_customer_id")
  // Durable institutional-seller attribution (pack 01 doc 09). Captured at
  // consignment time so history survives later org-membership changes — it is
  // NOT derived from the owner's current membership. Nullable + additive.
  sellerOrganizationId String?        @map("seller_organization_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  owner              Customer?     @relation(fields: [ownerCustomerId], references: [id])
  sellerOrganization Organization? @relation(fields: [sellerOrganizationId], references: [id])
  listings           Listing[]
  media              MediaObject[]

  @@index([category])
  @@index([ownerCustomerId])
  @@index([sellerOrganizationId])
  @@map("asset")
}

model Listing {
  id         String        @id
  assetId    String        @map("asset_id")
  saleMethod SaleMethod    @map("sale_method")
  status     ListingStatus @default(draft)
  publicRef  String        @unique @map("public_ref")
  title      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  // Buy Now price (set by staff for BUY_NOW listings). Nullable + additive.
  buyNowPriceMinor BigInt? @map("buy_now_price_minor")
  currency         String  @default("LKR")

  // Public content (consolidated pack doc 06) — additive; do NOT overload asset
  // attributes with public copy. All nullable so existing rows stay valid.
  shortDescription  String?   @map("short_description")
  fullDescription   String?   @map("full_description")
  locationCity      String?   @map("location_city")
  locationRegion    String?   @map("location_region")
  inspectionSummary String?   @map("inspection_summary")
  collectionSummary String?   @map("collection_summary")
  seoTitle          String?   @map("seo_title")
  seoDescription    String?   @map("seo_description")
  publicTermsRef    String?   @map("public_terms_ref")
  featured          Boolean   @default(false)
  // Sale-mode display config (guide price + non-auction sale window).
  guidePriceMinor   BigInt?   @map("guide_price_minor")
  showGuidePrice    Boolean   @default(false) @map("show_guide_price")
  opensAt           DateTime? @map("opens_at")
  closesAt          DateTime? @map("closes_at")

  asset           Asset             @relation(fields: [assetId], references: [id])
  auction         Auction?
  eois            Eoi[]
  sale            Sale?
  offers          Offer[]
  tenderBids      TenderBid[]
  invoice         Invoice?
  fulfilment      Fulfilment?
  settlement      Settlement?
  watches         Watch[]
  eventLots       AuctionEventLot[]
  discoveryEvents DiscoveryEvent[]

  @@index([assetId])
  @@index([status])
  @@index([featured])
  @@map("listing")
}

// Authoritative watchlist (consolidated pack doc 06) — one row per
// customer/listing pair. Replaces the frontend's localStorage-only watchlist.
model Watch {
  id         String   @id
  customerId String   @map("customer_id")
  listingId  String   @map("listing_id")
  createdAt  DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([customerId, listingId])
  @@index([customerId])
  @@index([listingId])
  @@map("watch")
}

// A curated event ABOVE individual lots/auctions (consolidated pack doc 06):
// physical/live multi-lot events, sequential/group timed sales, event pages.
// Individual Auction/Bid records remain authoritative.
enum AuctionEventType {
  timed
  live
  hybrid
  sequential
}

enum AuctionEventStatus {
  draft
  scheduled
  live
  ended
  cancelled
}

model AuctionEvent {
  id             String             @id
  publicRef      String             @unique @map("public_ref")
  title          String
  description    String?
  eventType      AuctionEventType   @default(timed) @map("event_type")
  status         AuctionEventStatus @default(draft)
  startsAt       DateTime?          @map("starts_at")
  venue          String?
  locationCity   String?            @map("location_city")
  heroMediaId    String?            @map("hero_media_id")
  termsRef       String?            @map("terms_ref")
  inspectionInfo String?            @map("inspection_info")
  liveEnabled    Boolean            @default(false) @map("live_enabled")
  featured       Boolean            @default(false)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  lots AuctionEventLot[]

  @@index([status])
  @@index([featured])
  @@map("auction_event")
}

model AuctionEventLot {
  id             String    @id
  auctionEventId String    @map("auction_event_id")
  listingId      String    @map("listing_id")
  sequence       Int
  lane           String?
  scheduledStart DateTime? @map("scheduled_start")

  event   AuctionEvent @relation(fields: [auctionEventId], references: [id])
  listing Listing      @relation(fields: [listingId], references: [id])

  @@unique([auctionEventId, listingId])
  @@unique([auctionEventId, sequence])
  @@index([listingId])
  @@map("auction_event_lot")
}

// A completed award for a listing, from any sale channel. UNIQUE per listing —
// a unique asset cannot sell twice (docs/07 Buy Now). Phase 6 commerce invoices
// reference this record.
enum SaleChannel {
  auction
  eoi
  buy_now
  make_offer
  sealed_tender
  live
}

model Sale {
  id                   String      @id
  listingId            String      @unique @map("listing_id")
  buyerCustomerId      String      @map("buyer_customer_id")
  channel              SaleChannel
  amountMinor          BigInt      @map("amount_minor")
  currency             String      @default("LKR")
  // Durable seller-org attribution copied from the asset at award time (pack 01
  // doc 09), so settlement/financial history stays attributed even if the
  // consigning employee later leaves the organization. Nullable + additive.
  sellerOrganizationId String?     @map("seller_organization_id")
  createdAt            DateTime    @default(now()) @map("created_at")

  listing            Listing       @relation(fields: [listingId], references: [id])
  sellerOrganization Organization? @relation(fields: [sellerOrganizationId], references: [id])

  @@index([buyerCustomerId])
  @@index([sellerOrganizationId])
  @@map("sale")
}

enum OfferStatus {
  open
  countered
  accepted
  rejected
  withdrawn
  expired
}

// Make Offer (docs/07): the current negotiation state; full history is appended
// to OfferEvent. `amountMinor` is the amount currently on the table.
model Offer {
  id          String      @id
  listingId   String      @map("listing_id")
  customerId  String      @map("customer_id")
  status      OfferStatus @default(open)
  amountMinor BigInt      @map("amount_minor")
  currency    String      @default("LKR")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  listing Listing      @relation(fields: [listingId], references: [id])
  events  OfferEvent[]

  @@index([listingId])
  @@index([customerId])
  @@map("offer")
}

enum OfferEventType {
  offer
  counter
  accept
  reject
  withdraw
  expire
}

// Append-only offer/counter history (docs/07 Make Offer).
model OfferEvent {
  id          String         @id
  offerId     String         @map("offer_id")
  type        OfferEventType
  amountMinor BigInt?        @map("amount_minor")
  note        String?
  actorType   ActorType      @map("actor_type")
  actorId     String?        @map("actor_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id])

  @@index([offerId])
  @@map("offer_event")
}

// Sealed Tender (docs/07): private submissions, revealed only on a controlled
// staff-triggered open. `openedAt` is null while sealed; competitor values are
// never returned before the open.
model TenderBid {
  id          String    @id
  listingId   String    @map("listing_id")
  customerId  String    @map("customer_id")
  amountMinor BigInt    @map("amount_minor")
  currency    String    @default("LKR")
  openedAt    DateTime? @map("opened_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([listingId, customerId])
  @@index([listingId])
  @@map("tender_bid")
}

model MediaObject {
  id         String      @id
  assetId    String      @map("asset_id")
  kind       MediaKind
  storageKey String      @map("storage_key")
  status     MediaStatus @default(uploading)
  // Originals are immutable; this stays true and is enforced by convention +
  // the derivative pointer below. Enhanced/processed media are separate rows.
  isOriginal Boolean     @default(true) @map("is_original")
  createdAt  DateTime    @default(now()) @map("created_at")

  // Presentation + processing metadata (consolidated pack doc 06/08). Additive.
  sortOrder  Int     @default(0) @map("sort_order")
  isCover    Boolean @default(false) @map("is_cover")
  caption    String?
  visibility String  @default("public")
  mimeType   String? @map("mime_type")
  sizeBytes  Int?    @map("size_bytes")
  width      Int?
  height     Int?
  durationMs Int?    @map("duration_ms")
  checksum   String?

  asset       Asset             @relation(fields: [assetId], references: [id])
  derivatives MediaDerivative[]

  @@index([assetId])
  @@index([assetId, sortOrder])
  @@map("media_object")
}

model MediaDerivative {
  id            String   @id
  sourceMediaId String   @map("source_media_id")
  method        String
  storageKey    String   @map("storage_key")
  createdAt     DateTime @default(now()) @map("created_at")

  source MediaObject @relation(fields: [sourceMediaId], references: [id])

  @@index([sourceMediaId])
  @@map("media_derivative")
}

// ---------------------------------------------------------------------------
// Audit (docs/04, docs/15) — APPEND-ONLY business evidence. A database trigger
// (see the audit_append_only migration) rejects UPDATE and DELETE.
// ---------------------------------------------------------------------------

model AuditEvent {
  id            String    @id
  actorType     ActorType @map("actor_type")
  actorId       String?   @map("actor_id")
  action        String
  targetType    String    @map("target_type")
  targetId      String    @map("target_id")
  correlationId String    @map("correlation_id")
  reason        String?
  before        Json?
  after         Json?
  occurredAt    DateTime  @default(now()) @map("occurred_at")

  @@index([targetType, targetId])
  @@index([correlationId])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Transactional outbox + platform config (docs/16, docs/18, docs/20)
// ---------------------------------------------------------------------------

model OutboxEvent {
  id             String       @id
  eventId        String       @unique @map("event_id")
  name           String
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id")
  correlationId  String       @map("correlation_id")
  causationId    String?      @map("causation_id")
  payload        Json
  payloadVersion Int          @default(1) @map("payload_version")
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  occurredAt     DateTime     @map("occurred_at")
  dispatchedAt   DateTime?    @map("dispatched_at")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("outbox_event")
}

// Idempotency for bids/payments/purchases/publication (docs/16).
model IdempotencyRecord {
  id         String    @id
  key        String    @unique
  scope      String
  resultHash String?   @map("result_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@index([scope])
  @@map("idempotency_record")
}

model FeatureFlag {
  id          String   @id
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flag")
}

// Business config with an explicit "needs product-owner approval" marker (docs/20).
model BusinessConfig {
  id               String   @id
  key              String   @unique
  value            String
  approvalRequired Boolean  @default(true) @map("approval_required")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("business_config")
}

// ---------------------------------------------------------------------------
// Auction engine (docs/07) — server-authoritative. UI is never the source of
// truth. The Bid ledger is append-only (a DB trigger rejects UPDATE/DELETE);
// corrections are new reversal rows. Proxy maximums are PRIVATE and never
// exposed. Money is integer minor units.
// ---------------------------------------------------------------------------

enum AuctionStatus {
  scheduled
  open
  paused
  closed
  cancelled
}

enum BidSource {
  online
  floor
  phone
  absentee
  proxy
  auctioneer
}

enum BidStatus {
  accepted
  rejected
  reversed
}

model Auction {
  id                  String        @id
  listingId           String        @unique @map("listing_id")
  status              AuctionStatus @default(scheduled)
  currency            String        @default("LKR")
  startsAt            DateTime      @map("starts_at")
  endsAt              DateTime      @map("ends_at")
  openingBidMinor     BigInt        @map("opening_bid_minor")
  reserveMinor        BigInt?       @map("reserve_minor")
  reserveVisible      Boolean       @default(false) @map("reserve_visible")
  incrementMinor      BigInt        @map("increment_minor")
  softCloseTriggerSec Int           @default(10) @map("soft_close_trigger_sec")
  softCloseExtendSec  Int           @default(20) @map("soft_close_extend_sec")
  buyerPremiumPct     Float         @default(0) @map("buyer_premium_pct")
  // Denormalized realtime projection (rebuildable from the ledger).
  currentBidMinor     BigInt?       @map("current_bid_minor")
  highBidderId        String?       @map("high_bidder_id")
  highBidId           String?       @map("high_bid_id")
  extendedCount       Int           @default(0) @map("extended_count")
  version             Int           @default(0)
  winnerCustomerId    String?       @map("winner_customer_id")
  soldAt              DateTime?     @map("sold_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  listing Listing     @relation(fields: [listingId], references: [id])
  bids    Bid[]
  maxes   BidderMax[]

  @@index([status, endsAt])
  @@map("auction")
}

// Append-only bid ledger (docs/04). Each visible price the engine sets is a row.
model Bid {
  id             String    @id
  auctionId      String    @map("auction_id")
  sequence       Int
  bidderId       String    @map("bidder_id")
  amountMinor    BigInt    @map("amount_minor")
  source         BidSource @default(online)
  status         BidStatus @default(accepted)
  idempotencyKey String?   @map("idempotency_key")
  placedAt       DateTime  @default(now()) @map("placed_at")

  auction Auction @relation(fields: [auctionId], references: [id])

  @@unique([auctionId, sequence])
  @@index([auctionId])
  @@map("bid")
}

// Private per-bidder proxy maximum (never exposed to other bidders / analytics).
model BidderMax {
  id        String   @id
  auctionId String   @map("auction_id")
  bidderId  String   @map("bidder_id")
  maxMinor  BigInt   @map("max_minor")
  updatedAt DateTime @updatedAt @map("updated_at")

  auction Auction @relation(fields: [auctionId], references: [id])

  @@unique([auctionId, bidderId])
  @@index([auctionId])
  @@map("bidder_max")
}

enum EoiStatus {
  submitted
  under_review
  shortlisted
  negotiating
  accepted
  declined
  withdrawn
  expired
}

// Expression of Interest (docs/07). A PRIVATE structured submission: amount,
// message and conditions are visible only to the submitter and authorised
// staff, never to competing bidders. Status changes are appended to EoiEvent.
model Eoi {
  id          String    @id
  listingId   String    @map("listing_id")
  customerId  String    @map("customer_id")
  status      EoiStatus @default(submitted)
  amountMinor BigInt?   @map("amount_minor")
  currency    String    @default("LKR")
  message     String?
  conditions  String?
  expiresAt   DateTime? @map("expires_at")
  reviewNote  String?   @map("review_note")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  listing Listing    @relation(fields: [listingId], references: [id])
  events  EoiEvent[]

  @@index([listingId])
  @@index([customerId])
  @@index([status])
  @@map("eoi")
}

// Append-only status history for an EOI (immutable audit of negotiation).
model EoiEvent {
  id         String    @id
  eoiId      String    @map("eoi_id")
  fromStatus EoiStatus @map("from_status")
  toStatus   EoiStatus @map("to_status")
  note       String?
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  eoi Eoi @relation(fields: [eoiId], references: [id])

  @@index([eoiId])
  @@map("eoi_event")
}

// ---------------------------------------------------------------------------
// Commerce (docs/14) — invoice, append-only financial ledger, payment, release,
// fulfilment and seller settlement. A won/accepted listing is NOT a completed
// transaction; the platform continues through this pipeline.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  issued
  paid
  void
}

model Invoice {
  id                  String        @id
  number              String        @unique
  listingId           String        @unique @map("listing_id")
  saleId              String        @map("sale_id")
  buyerCustomerId     String        @map("buyer_customer_id")
  currency            String        @default("LKR")
  hammerMinor         BigInt        @map("hammer_minor")
  buyerPremiumMinor   BigInt        @map("buyer_premium_minor")
  taxMinor            BigInt        @map("tax_minor")
  otherFeesMinor      BigInt        @default(0) @map("other_fees_minor")
  depositAppliedMinor BigInt        @default(0) @map("deposit_applied_minor")
  amountDueMinor      BigInt        @map("amount_due_minor")
  status              InvoiceStatus @default(issued)
  dueAt               DateTime      @map("due_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  listing  Listing       @relation(fields: [listingId], references: [id])
  payments Payment[]
  ledger   LedgerEntry[]

  @@index([buyerCustomerId])
  @@map("invoice")
}

enum LedgerEntryType {
  deposit_received
  sale_charge
  buyer_premium
  tax
  payment_received
  refund
  credit_applied
  settlement_disbursed
}

// APPEND-ONLY financial ledger (docs/14). We never model a mutable balance;
// every money movement is an immutable event. A DB trigger rejects UPDATE/DELETE.
model LedgerEntry {
  id          String          @id
  listingId   String          @map("listing_id")
  invoiceId   String?         @map("invoice_id")
  entryType   LedgerEntryType @map("entry_type")
  amountMinor BigInt          @map("amount_minor")
  currency    String          @default("LKR")
  reference   String?
  actorType   ActorType       @map("actor_type")
  actorId     String?         @map("actor_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([listingId])
  @@index([invoiceId])
  @@map("ledger_entry")
}

enum PaymentStatus {
  pending_verification
  confirmed
  rejected
}

// Manual bank transfer flow (docs/14): uploading proof is NEVER equivalent to
// being paid — staff/accounts verify, then a ledger event records confirmation.
model Payment {
  id          String        @id
  invoiceId   String        @map("invoice_id")
  amountMinor BigInt        @map("amount_minor")
  method      String        @default("bank_transfer")
  status      PaymentStatus @default(pending_verification)
  proofRef    String?       @map("proof_ref")
  verifiedBy  String?       @map("verified_by")
  verifiedAt  DateTime?     @map("verified_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payment")
}

enum FulfilmentState {
  payment_pending
  payment_confirmed
  release_approved
  ready_for_pickup
  pickup_booked
  in_delivery
  collected
  delivered
  completed
}

model Fulfilment {
  id         String          @id
  listingId  String          @unique @map("listing_id")
  state      FulfilmentState @default(payment_pending)
  releaseRef String?         @map("release_ref")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@map("fulfilment")
}

model Settlement {
  id                 String   @id
  listingId          String   @unique @map("listing_id")
  saleProceedsMinor  BigInt   @map("sale_proceeds_minor")
  commissionMinor    BigInt   @map("commission_minor")
  commissionTaxMinor BigInt   @map("commission_tax_minor")
  deductionsMinor    BigInt   @default(0) @map("deductions_minor")
  netMinor           BigInt   @map("net_minor")
  reference          String?
  reason             String?
  createdAt          DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@map("settlement")
}

// ---------------------------------------------------------------------------
// Singha Connect (docs/09) — omnichannel: ONE customer identity + conversation
// history across channels. Providers live behind adapters; channel windows/
// templates are adapter config, never customer core tables.
// ---------------------------------------------------------------------------

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  inbound
  outbound
}

// Who/what produced a message (AI is always a distinct, auditable provenance).
enum MessageProvenance {
  customer
  staff
  ai
  system
}

model Conversation {
  id               String             @id
  customerId       String?            @map("customer_id")
  channel          ChannelType
  externalThreadId String             @map("external_thread_id")
  status           ConversationStatus @default(open)
  aiMode           Boolean            @default(true) @map("ai_mode")
  assignedAgentId  String?            @map("assigned_agent_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  messages Message[]

  @@unique([channel, externalThreadId])
  @@index([customerId])
  @@map("conversation")
}

model Message {
  id                String            @id
  conversationId    String            @map("conversation_id")
  direction         MessageDirection
  providerMessageId String?           @map("provider_message_id")
  sender            String?
  text              String?
  payload           Json?
  provenance        MessageProvenance @default(customer)
  createdAt         DateTime          @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("message")
}

// Messaging-channel bidding (docs/07, rule 11): free text creates a BID INTENT,
// never a bid. An accepted bid requires explicit confirmation + auction-engine
// validation. The intent is signed/idempotent and single-use.
enum BidIntentStatus {
  pending
  confirmed
  placed
  rejected
  expired
}

model BidIntent {
  id             String          @id
  customerId     String          @map("customer_id")
  auctionId      String          @map("auction_id")
  maxAmountMinor BigInt          @map("max_amount_minor")
  channel        ChannelType     @default(web)
  status         BidIntentStatus @default(pending)
  bidId          String?         @map("bid_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  confirmedAt    DateTime?       @map("confirmed_at")

  @@index([customerId])
  @@index([auctionId])
  @@map("bid_intent")
}

// ---------------------------------------------------------------------------
// Singha AI Core (docs/10) — AI outputs are DERIVED records (rule 3): they never
// overwrite original facts/media/bids/finance. Every AI invocation is recorded
// with provenance for governance; a human explicitly APPLIES a draft.
// ---------------------------------------------------------------------------

enum AiTaskType {
  listing_draft
  media_caption
  assistant
  translation
  recommendation
  support
}

model AiRun {
  id          String     @id
  taskType    AiTaskType @map("task_type")
  model       String
  provider    String     @default("mock")
  actorId     String?    @map("actor_id")
  subjectType String?    @map("subject_type")
  subjectId   String?    @map("subject_id")
  prompt      String?
  output      Json
  confidence  Float?
  applied     Boolean    @default(false)
  appliedBy   String?    @map("applied_by")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([subjectType, subjectId])
  @@index([taskType])
  @@map("ai_run")
}

// ---------------------------------------------------------------------------
// Singha Social Publisher (docs/11) — AI-assisted Facebook/Instagram creatives
// and campaigns. Publication records are their own data; publishing goes through
// an adapter (mock until Meta access). Publishing never mutates auction facts.
// ---------------------------------------------------------------------------

enum SocialPlatform {
  facebook
  instagram
}

enum SocialPublicationStatus {
  draft
  scheduled
  published
  failed
}

enum SocialCampaignType {
  individual
  group
}

model SocialCampaign {
  id        String             @id
  name      String
  type      SocialCampaignType @default(individual)
  createdAt DateTime           @default(now()) @map("created_at")

  publications SocialPublication[]

  @@map("social_campaign")
}

model SocialPublication {
  id             String                  @id
  listingId      String?                 @map("listing_id")
  campaignId     String?                 @map("campaign_id")
  platform       SocialPlatform
  status         SocialPublicationStatus @default(draft)
  caption        String
  creativeRef    String?                 @map("creative_ref")
  aiRunId        String?                 @map("ai_run_id")
  externalPostId String?                 @map("external_post_id")
  scheduledAt    DateTime?               @map("scheduled_at")
  publishedAt    DateTime?               @map("published_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  campaign SocialCampaign? @relation(fields: [campaignId], references: [id])

  @@index([listingId])
  @@index([campaignId])
  @@index([status])
  @@map("social_publication")
}

// ---------------------------------------------------------------------------
// Singha Live (docs/08) — live/hybrid auction broadcast. The ingest/simulcast
// providers are behind an adapter (mock until IVS/YouTube access). Live/floor/
// phone bids all enter the ONE authoritative bid ledger via the auction engine.
// ---------------------------------------------------------------------------

enum LiveStatus {
  scheduled
  live
  paused
  ended
}

model LiveEvent {
  id             String     @id
  auctionId      String?    @map("auction_id")
  title          String
  status         LiveStatus @default(scheduled)
  ingestProvider String     @default("mock") @map("ingest_provider")
  ingestUrl      String?    @map("ingest_url")
  playbackUrl    String?    @map("playback_url")
  simulcastUrl   String?    @map("simulcast_url")
  recordingUrl   String?    @map("recording_url")
  startedAt      DateTime?  @map("started_at")
  endedAt        DateTime?  @map("ended_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([auctionId])
  @@map("live_event")
}

// ---------------------------------------------------------------------------
// Member identity, credit, security & performance engine (Revision 05).
// Additive-only. One durable Customer can be Buyer, Seller or Both; membership,
// KYC, credit facility, bidding eligibility and performance are SEPARATE concerns.
// Only verified, eligible security supports credit. The 5% security ratio is
// configuration (basis points). Exposure is enforced transactionally. Internal
// performance/flags are private, deterministic and auditable. Money is BigInt
// minor units — never floats.
// ---------------------------------------------------------------------------

enum MembershipStatus {
  pending
  temporary
  active
  suspended
  blocked
  expired
}

enum GrantScopeType {
  platform
  event
  auction
  category
}

enum AccessGrantStatus {
  active
  expired
  revoked
}

enum SecurityInstrumentType {
  cash_deposit
  bank_guarantee
  spot_deposit
}

enum SecurityInstrumentStatus {
  pending_verification
  verified
  active
  expired
  release_pending
  released
  rejected
  cancelled
}

enum CreditFacilityStatus {
  pending
  active
  review_required
  suspended
  expired
  closed
}

enum CreditDecisionType {
  calculate
  approve
  cap
  uplift
  suspend
  reactivate
  close
  override
}

enum CreditReservationStatus {
  active
  released
  converted
}

enum PerformanceContext {
  buyer
  seller
}

enum MemberFlagContext {
  buyer
  seller
  general
}

enum MemberFlagSeverity {
  low
  medium
  high
  critical
}

enum MemberFlagStatus {
  open
  under_review
  resolved
  dismissed
  expired
}

// Membership lifecycle — one active row projects the customer's current state.
model Membership {
  id          String           @id
  customerId  String           @map("customer_id")
  status      MembershipStatus @default(pending)
  activatedAt DateTime?        @map("activated_at")
  suspendedAt DateTime?        @map("suspended_at")
  blockedAt   DateTime?        @map("blocked_at")
  expiresAt   DateTime?        @map("expires_at")
  reason      String?
  createdBy   String?          @map("created_by")
  updatedBy   String?          @map("updated_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("membership")
}

// Temporary / event-scoped access granted after an approved spot deposit.
model MembershipAccessGrant {
  id                   String            @id
  customerId           String            @map("customer_id")
  scopeType            GrantScopeType    @map("scope_type")
  scopeId              String?           @map("scope_id")
  startsAt             DateTime          @map("starts_at")
  expiresAt            DateTime          @map("expires_at")
  securityInstrumentId String?           @map("security_instrument_id")
  creditFacilityId     String?           @map("credit_facility_id")
  grantedBy            String?           @map("granted_by")
  reason               String?
  status               AccessGrantStatus @default(active)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([scopeType, scopeId])
  @@index([status])
  @@map("membership_access_grant")
}

// First-class security instruments. Only verified/active, non-expired, eligible
// instruments support new credit. Bank-guarantee documents are private.
model SecurityInstrument {
  id                  String                   @id
  customerId          String                   @map("customer_id")
  organizationId      String?                  @map("organization_id")
  type                SecurityInstrumentType
  currency            String                   @default("LKR")
  faceAmountMinor     BigInt                   @map("face_amount_minor")
  eligibleAmountMinor BigInt                   @default(0) @map("eligible_amount_minor")
  // Eligibility factor in basis points (10000 = 1.00; a haircut lowers it).
  eligibilityBps      Int                      @default(10000) @map("eligibility_bps")
  status              SecurityInstrumentStatus @default(pending_verification)
  reference           String?
  issuingBank         String?                  @map("issuing_bank")
  guaranteeNumber     String?                  @map("guarantee_number")
  issueDate           DateTime?                @map("issue_date")
  expiresAt           DateTime?                @map("expires_at")
  documentMediaId     String?                  @map("document_media_id")
  verifiedAt          DateTime?                @map("verified_at")
  verifiedBy          String?                  @map("verified_by")
  releasedAt          DateTime?                @map("released_at")
  releasedBy          String?                  @map("released_by")
  notes               String?
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  customer           Customer                 @relation(fields: [customerId], references: [id])
  organization       Organization?            @relation(fields: [organizationId], references: [id])
  facilitySecurities CreditFacilitySecurity[]

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
  @@map("security_instrument")
}

// Standing credit facility. calculated / approved / uplift are stored separately
// so overrides never overwrite the policy calculation.
model CreditFacility {
  id                       String               @id
  customerId               String               @map("customer_id")
  currency                 String               @default("LKR")
  scopeType                GrantScopeType       @default(platform) @map("scope_type")
  scopeId                  String?              @map("scope_id")
  calculatedBaseLimitMinor BigInt               @default(0) @map("calculated_base_limit_minor")
  approvedLimitMinor       BigInt               @default(0) @map("approved_limit_minor")
  temporaryUpliftMinor     BigInt               @default(0) @map("temporary_uplift_minor")
  status                   CreditFacilityStatus @default(pending)
  // Configurable required-security ratio in basis points (500 = 5.00%).
  requiredSecurityBps      Int                  @default(500) @map("required_security_bps")
  policyVersion            String               @default("credit-v1") @map("policy_version")
  startsAt                 DateTime             @default(now()) @map("starts_at")
  expiresAt                DateTime?            @map("expires_at")
  approvedBy               String?              @map("approved_by")
  approvalReason           String?              @map("approval_reason")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")

  customer     Customer                 @relation(fields: [customerId], references: [id])
  securities   CreditFacilitySecurity[]
  decisions    CreditDecision[]
  reservations CreditReservation[]

  @@index([customerId])
  @@index([status])
  @@map("credit_facility")
}

// Join: which verified security instruments support a facility.
model CreditFacilitySecurity {
  id                   String   @id
  facilityId           String   @map("facility_id")
  securityInstrumentId String   @map("security_instrument_id")
  createdAt            DateTime @default(now()) @map("created_at")

  facility CreditFacility     @relation(fields: [facilityId], references: [id])
  security SecurityInstrument @relation(fields: [securityInstrumentId], references: [id])

  @@unique([facilityId, securityInstrumentId])
  @@index([securityInstrumentId])
  @@map("credit_facility_security")
}

// Append-only credit decision history — prior decisions are never overwritten.
model CreditDecision {
  id                 String             @id
  facilityId         String             @map("facility_id")
  decisionType       CreditDecisionType @map("decision_type")
  previousLimitMinor BigInt?            @map("previous_limit_minor")
  newLimitMinor      BigInt?            @map("new_limit_minor")
  reason             String?
  decidedBy          String?            @map("decided_by")
  secondApprover     String?            @map("second_approver")
  policyVersion      String?            @map("policy_version")
  createdAt          DateTime           @default(now()) @map("created_at")

  facility CreditFacility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@map("credit_decision")
}

// Authoritative exposure record. active reservations are committed exposure;
// available = effectiveApprovedLimit − sum(active reservations).
model CreditReservation {
  id                String                  @id
  customerId        String                  @map("customer_id")
  facilityId        String                  @map("facility_id")
  sourceType        String                  @map("source_type")
  sourceId          String                  @map("source_id")
  amountMinor       BigInt                  @map("amount_minor")
  currency          String                  @default("LKR")
  status            CreditReservationStatus @default(active)
  convertedToSaleId String?                 @map("converted_to_sale_id")
  releasedAt        DateTime?               @map("released_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  customer Customer       @relation(fields: [customerId], references: [id])
  facility CreditFacility @relation(fields: [facilityId], references: [id])

  // One live reservation per (customer, source) — re-bidding updates in place.
  @@unique([sourceType, sourceId])
  @@index([customerId, status])
  @@index([facilityId, status])
  @@map("credit_reservation")
}

// Objective, append-only performance events. Internal, separated from permanent
// customer facts; the deterministic rule engine folds these into snapshots.
model PerformanceEvent {
  id               String             @id
  customerId       String             @map("customer_id")
  context          PerformanceContext
  eventType        String             @map("event_type")
  dimension        String
  value            Float              @default(1)
  sourceEntityType String?            @map("source_entity_type")
  sourceEntityId   String?            @map("source_entity_id")
  occurredAt       DateTime           @default(now()) @map("occurred_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, context])
  @@map("performance_event")
}

// Rebuildable performance snapshot — score/band + component breakdown + rule
// version. score is null for INSUFFICIENT_HISTORY.
model PerformanceSnapshot {
  id          String             @id
  customerId  String             @map("customer_id")
  context     PerformanceContext
  score       Int?
  band        String
  ruleVersion String             @map("rule_version")
  components  Json               @default("{}")
  generatedAt DateTime           @default(now()) @map("generated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, context])
  @@map("performance_snapshot")
}

// Structured internal review / caution flag. Private, role-restricted, auditable.
// Never a single free-text blacklist field; resolution preserves history.
model MemberFlag {
  id          String             @id
  customerId  String             @map("customer_id")
  context     MemberFlagContext  @default(general)
  category    String
  severity    MemberFlagSeverity @default(low)
  status      MemberFlagStatus   @default(open)
  reasonCode  String             @map("reason_code")
  title       String
  privateNote String?            @map("private_note")
  evidence    Json               @default("[]")
  createdBy   String?            @map("created_by")
  reviewedBy  String?            @map("reviewed_by")
  resolvedBy  String?            @map("resolved_by")
  resolvedAt  DateTime?          @map("resolved_at")
  expiresAt   DateTime?          @map("expires_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, status])
  @@map("member_flag")
}

// ---------------------------------------------------------------------------
// V3 — Singha Discover + Buyer Twin (pack docs 06/11). Additive, rebuildable.
// The append-only DiscoveryEvent ledger is the durable preference record; the
// BuyerTwinProjection is a DROPPABLE cache recomputed by the engine. `eventType`
// and `sourceSurface` are stored as text validated by the @singha/contracts zod
// enums at the API boundary. `metadata` is a strict primitive allow-list — never
// raw device fingerprints or sensitive traits.
// ---------------------------------------------------------------------------

model DiscoveryEvent {
  id                 String   @id
  customerId         String?  @map("customer_id")
  anonymousSessionId String?  @map("anonymous_session_id")
  listingId          String   @map("listing_id")
  eventType          String   @map("event_type")
  sourceSurface      String   @default("FLOW") @map("source_surface")
  bandContext        String?  @map("band_context")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id])
  listing  Listing   @relation(fields: [listingId], references: [id])

  @@index([customerId, createdAt])
  @@index([anonymousSessionId, createdAt])
  @@index([listingId])
  @@map("discovery_event")
}

// One rebuildable projection per customer. `data` is the internal (Tier-A) projection
// JSON and is NEVER served raw — the API maps it to the safe BuyerTwinSummary.
model BuyerTwinProjection {
  customerId  String   @id @map("customer_id")
  version     Int
  data        Json
  builtAt     DateTime @map("built_at")
  signalCount Int      @map("signal_count")

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("buyer_twin_projection")
}

// Measures whether a recommendation was shown (so we can avoid repeating it and
// later measure effectiveness). FK-less analytics log.
model RecommendationImpression {
  id         String   @id
  customerId String?  @map("customer_id")
  listingId  String   @map("listing_id")
  surface    String   @default("DISCOVER")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId, listingId])
  @@map("recommendation_impression")
}
