// Singha Auctions V2 — Phase 0 stable data core.
// Non-negotiable rules (docs/04): permanent records survive app rewrites; IDs are
// opaque ULIDs minted by the app; audit + financial history is append-only;
// original media is immutable; integration is via a transactional outbox.
//
// Scope of this schema = Phase 0 foundations only: identity, inventory, media
// provenance, audit, outbox and platform config. Later phases add auction, EOI,
// commerce, live, etc. via ADDITIVE migrations (expand-migrate-verify-contract).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations — Supabase pooler-safe.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CustomerStatus {
  prospect
  active
  suspended
  closed
}

enum KycStatus {
  none
  pending
  verified
  rejected
}

enum ChannelType {
  web
  whatsapp
  facebook
  instagram
  email
  sms
}

enum OrgRole {
  owner
  admin
  staff
}

enum AssetLifecycle {
  draft
  in_intake
  available
  reserved
  sold
  withdrawn
  archived
}

enum SaleMethod {
  TIMED_AUCTION
  EXPRESSION_OF_INTEREST
  BUY_NOW
  MAKE_OFFER
  SEALED_TENDER
  LIVE_HYBRID
}

enum ListingStatus {
  draft
  submitted
  review
  changes_required
  approved
  scheduled
  live
  ended
  sold
  unsold
  withdrawn
}

enum MediaKind {
  image
  video
  document
  video_thumbnail
}

enum MediaStatus {
  uploading
  processing
  ready
  failed
  archived
}

enum ActorType {
  customer
  staff
  system
  ai
}

enum OutboxStatus {
  pending
  dispatched
  failed
}

// ---------------------------------------------------------------------------
// Identity (docs/05) — verified facts only; AI intelligence lives elsewhere.
// ---------------------------------------------------------------------------

model Customer {
  id              String         @id
  status          CustomerStatus @default(prospect)
  // Human-readable, immutable, never-recycled Client ID (e.g. CUS-000001),
  // generated by an atomic DB sequence — NOT the primary key (Revision 05 §10/§3).
  clientReference String?        @unique @map("client_reference")
  legalName       String?        @map("legal_name")
  email           String?        @unique
  phone           String?        @unique
  kycStatus       KycStatus      @default(none) @map("kyc_status")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  externalIdentities     ExternalIdentity[]
  organizationMembers    OrganizationMember[]
  ownedAssets            Asset[]
  memberships            Membership[]
  accessGrants           MembershipAccessGrant[]
  securityInstruments    SecurityInstrument[]
  creditFacilities       CreditFacility[]
  creditReservations     CreditReservation[]
  performanceEvents      PerformanceEvent[]
  performanceSnapshots   PerformanceSnapshot[]
  memberFlags            MemberFlag[]
  discoveryEvents        DiscoveryEvent[]
  buyerTwin              BuyerTwinProjection?
  notificationPreference NotificationPreference?
  notificationDeliveries NotificationDelivery[]
  sellerListingDrafts    SellerListingDraft[]

  @@map("customer")
}

// External channel identities NEVER replace customer_id (docs/05).
model ExternalIdentity {
  id         String      @id
  customerId String      @map("customer_id")
  channel    ChannelType
  externalId String      @map("external_id")
  verifiedAt DateTime?   @map("verified_at")
  createdAt  DateTime    @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([channel, externalId])
  @@index([customerId])
  @@map("external_identity")
}

model Organization {
  id                    String   @id
  legalName             String   @map("legal_name")
  publicRef             String   @unique @map("public_ref")
  // Durable, human-readable Organization reference (e.g. ORG-000001), separate
  // atomic sequence from Customer Client IDs (Revision 05 §10).
  organizationReference String?  @unique @map("organization_reference")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  members             OrganizationMember[]
  sellerAssets        Asset[]
  sellerSales         Sale[]
  securityInstruments SecurityInstrument[]

  @@map("organization")
}

model OrganizationMember {
  id             String   @id
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  role           OrgRole  @default(staff)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@unique([organizationId, customerId])
  @@index([customerId])
  @@map("organization_member")
}

// ---------------------------------------------------------------------------
// Inventory & media (docs/04, docs/06) — Asset is enduring; Listing is a sale
// attempt; original media is immutable, derivatives carry provenance.
// ---------------------------------------------------------------------------

model Asset {
  id                   String         @id
  category             String
  // §3 — customer-facing subcategory (config-driven taxonomy in @singha/contracts). Nullable +
  // additive; indexed for catalogue facets/filtering. The category stays the stable top-level key.
  subcategory          String?
  schemaVersion        Int            @default(1) @map("schema_version")
  // Category-specific attributes, validated against the versioned category
  // schema (docs/06). Nullable + additive so pre-existing assets stay valid.
  attributes           Json?
  lifecycle            AssetLifecycle @default(draft)
  ownerCustomerId      String?        @map("owner_customer_id")
  // Durable institutional-seller attribution (pack 01 doc 09). Captured at
  // consignment time so history survives later org-membership changes — it is
  // NOT derived from the owner's current membership. Nullable + additive.
  sellerOrganizationId String?        @map("seller_organization_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  owner              Customer?                 @relation(fields: [ownerCustomerId], references: [id])
  sellerOrganization Organization?             @relation(fields: [sellerOrganizationId], references: [id])
  listings           Listing[]
  media              MediaObject[]
  inspectionEvidence AssetInspectionEvidence[]

  @@index([category])
  @@index([category, subcategory])
  @@index([ownerCustomerId])
  @@index([sellerOrganizationId])
  @@map("asset")
}

model Listing {
  id         String        @id
  assetId    String        @map("asset_id")
  saleMethod SaleMethod    @map("sale_method")
  status     ListingStatus @default(draft)
  publicRef  String        @unique @map("public_ref")
  title      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  // Buy Now price (set by staff for BUY_NOW listings). Nullable + additive.
  buyNowPriceMinor BigInt? @map("buy_now_price_minor")
  currency         String  @default("LKR")

  // Public content (consolidated pack doc 06) — additive; do NOT overload asset
  // attributes with public copy. All nullable so existing rows stay valid.
  shortDescription  String?   @map("short_description")
  fullDescription   String?   @map("full_description")
  locationCity      String?   @map("location_city")
  locationRegion    String?   @map("location_region")
  inspectionSummary String?   @map("inspection_summary")
  collectionSummary String?   @map("collection_summary")
  seoTitle          String?   @map("seo_title")
  seoDescription    String?   @map("seo_description")
  publicTermsRef    String?   @map("public_terms_ref")
  featured          Boolean   @default(false)
  // Sale-mode display config (guide price + non-auction sale window).
  guidePriceMinor   BigInt?   @map("guide_price_minor")
  showGuidePrice    Boolean   @default(false) @map("show_guide_price")
  opensAt           DateTime? @map("opens_at")
  closesAt          DateTime? @map("closes_at")

  // Singha Evolution E3 — universal listing (additive, all nullable; consumers migrate later).
  // Configurable sale method alongside the enum (DECISIONS D3); backfilled from `saleMethod`.
  saleMethodCode         String?  @map("sale_method_code")
  // Quantity + unit engine (pack doc 13; DECISIONS D5 — Decimal, never float).
  quantityAvailable      Decimal? @map("quantity_available") @db.Decimal(38, 9)
  minOrderQuantity       Decimal? @map("min_order_quantity") @db.Decimal(38, 9)
  quantityUnitCode       String?  @map("quantity_unit_code")
  pricingBasis           String?  @map("pricing_basis")
  unitPriceMinor         BigInt?  @map("unit_price_minor")
  // Structured location roles (pack doc 15) — distinct from the flat locationCity/Region above.
  assetLocationId        String?  @map("asset_location_id")
  sellerLocationId       String?  @map("seller_location_id")
  custodianLocationId    String?  @map("custodian_location_id")
  pickupLocationId       String?  @map("pickup_location_id")
  exportOriginLocationId String?  @map("export_origin_location_id")
  destinationLocationId  String?  @map("destination_location_id")
  // Operator + origin-node attribution (Addendum A: origination is attribution, not ownership).
  operatorId             String?  @map("operator_id")
  originNodeId           String?  @map("origin_node_id")
  // §2/§11 — seller-declared logistics terms captured at listing time (all nullable/additive).
  // `defaultIncoterm` is validated against the configurable INCOTERMS list at the app layer;
  // pickup/delivery are the seller's own availability declaration, OR-combined in the catalogue
  // facets with the structured pickup/destination Location roles above so either path surfaces.
  defaultIncoterm        String?  @map("default_incoterm")
  pickupAvailable        Boolean? @map("pickup_available")
  deliveryAvailable      Boolean? @map("delivery_available")

  asset             Asset                    @relation(fields: [assetId], references: [id])
  auction           Auction?
  eois              Eoi[]
  sale              Sale?
  offers            Offer[]
  tenderBids        TenderBid[]
  invoice           Invoice?
  fulfilment        Fulfilment?
  settlement        Settlement?
  watches           Watch[]
  eventLots         AuctionEventLot[]
  discoveryEvents   DiscoveryEvent[]
  auctionPreference SellerAuctionPreference?

  assetLocation        Location?   @relation("ListingAssetLocation", fields: [assetLocationId], references: [id])
  sellerLocation       Location?   @relation("ListingSellerLocation", fields: [sellerLocationId], references: [id])
  custodianLocation    Location?   @relation("ListingCustodianLocation", fields: [custodianLocationId], references: [id])
  pickupLocation       Location?   @relation("ListingPickupLocation", fields: [pickupLocationId], references: [id])
  exportOriginLocation Location?   @relation("ListingExportOriginLocation", fields: [exportOriginLocationId], references: [id])
  destinationLocation  Location?   @relation("ListingDestinationLocation", fields: [destinationLocationId], references: [id])
  operator             Operator?   @relation(fields: [operatorId], references: [id])
  originNode           MarketNode? @relation(fields: [originNodeId], references: [id])

  @@index([assetId])
  @@index([status])
  @@index([featured])
  @@index([operatorId])
  @@index([originNodeId])
  @@map("listing")
}

// Authoritative watchlist (consolidated pack doc 06) — one row per
// customer/listing pair. Replaces the frontend's localStorage-only watchlist.
model Watch {
  id         String   @id
  customerId String   @map("customer_id")
  listingId  String   @map("listing_id")
  createdAt  DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([customerId, listingId])
  @@index([customerId])
  @@index([listingId])
  @@map("watch")
}

// A curated event ABOVE individual lots/auctions (consolidated pack doc 06):
// physical/live multi-lot events, sequential/group timed sales, event pages.
// Individual Auction/Bid records remain authoritative.
enum AuctionEventType {
  timed
  live
  hybrid
  sequential
}

enum AuctionEventStatus {
  draft
  scheduled
  live
  ended
  cancelled
}

// §21/§22 (RW6) — per-lot state on the live floor (the auctioneer's rostrum lifecycle). The
// AUTHORITATIVE bid/price stays in the Auction/Bid ledger (rule 12); this is the presentation
// state the auctioneer drives (on the block → going once → going twice → sold/passed).
enum LiveLotState {
  pending
  on_block
  going_once
  going_twice
  sold
  passed
  withdrawn
}

model AuctionEvent {
  id             String             @id
  publicRef      String             @unique @map("public_ref")
  title          String
  description    String?
  eventType      AuctionEventType   @default(timed) @map("event_type")
  status         AuctionEventStatus @default(draft)
  startsAt       DateTime?          @map("starts_at")
  venue          String?
  locationCity   String?            @map("location_city")
  heroMediaId    String?            @map("hero_media_id")
  termsRef       String?            @map("terms_ref")
  inspectionInfo String?            @map("inspection_info")
  liveEnabled    Boolean            @default(false) @map("live_enabled")
  featured       Boolean            @default(false)
  // RW6 — the lot currently on the block (the auctioneer's current-lot pointer). Nullable +
  // additive; references an AuctionEventLot.id but not an FK relation to keep the migration additive.
  currentLotId   String?            @map("current_lot_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  lots AuctionEventLot[]

  @@index([status])
  @@index([featured])
  @@map("auction_event")
}

model AuctionEventLot {
  id             String       @id
  auctionEventId String       @map("auction_event_id")
  listingId      String       @map("listing_id")
  sequence       Int
  lane           String?
  scheduledStart DateTime?    @map("scheduled_start")
  // RW6 — auctioneer-driven presentation state (see LiveLotState). Additive, defaults to pending.
  liveState      LiveLotState @default(pending) @map("live_state")
  soldAt         DateTime?    @map("sold_at")

  event   AuctionEvent @relation(fields: [auctionEventId], references: [id])
  listing Listing      @relation(fields: [listingId], references: [id])

  @@unique([auctionEventId, listingId])
  @@unique([auctionEventId, sequence])
  @@index([listingId])
  @@map("auction_event_lot")
}

// A completed award for a listing, from any sale channel. UNIQUE per listing —
// a unique asset cannot sell twice (docs/07 Buy Now). Phase 6 commerce invoices
// reference this record.
enum SaleChannel {
  auction
  eoi
  buy_now
  make_offer
  sealed_tender
  live
}

model Sale {
  id                   String      @id
  listingId            String      @unique @map("listing_id")
  buyerCustomerId      String      @map("buyer_customer_id")
  channel              SaleChannel
  amountMinor          BigInt      @map("amount_minor")
  currency             String      @default("LKR")
  // Durable seller-org attribution copied from the asset at award time (pack 01
  // doc 09), so settlement/financial history stays attributed even if the
  // consigning employee later leaves the organization. Nullable + additive.
  sellerOrganizationId String?     @map("seller_organization_id")
  createdAt            DateTime    @default(now()) @map("created_at")

  listing            Listing       @relation(fields: [listingId], references: [id])
  sellerOrganization Organization? @relation(fields: [sellerOrganizationId], references: [id])

  @@index([buyerCustomerId])
  @@index([sellerOrganizationId])
  @@map("sale")
}

enum OfferStatus {
  open
  countered
  accepted
  rejected
  withdrawn
  expired
}

// Make Offer (docs/07): the current negotiation state; full history is appended
// to OfferEvent. `amountMinor` is the amount currently on the table.
model Offer {
  id          String      @id
  listingId   String      @map("listing_id")
  customerId  String      @map("customer_id")
  status      OfferStatus @default(open)
  amountMinor BigInt      @map("amount_minor")
  currency    String      @default("LKR")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Commercial Offer Engine V2 (E4, additive). Full proposal terms live in immutable
  // OfferRevisions; `amountMinor` stays the legacy headline. `sealed` offers are confidential
  // (no pre-reveal), and `awardPolicy` defaults to MANUAL_SELECTION — the highest sealed
  // proposal NEVER auto-awards (DECISIONS D4). `saleMethodCode` ties to the E2 taxonomy.
  currentRevisionId String?   @map("current_revision_id")
  saleMethodCode    String?   @map("sale_method_code")
  sealed            Boolean   @default(false)
  revealedAt        DateTime? @map("revealed_at")
  awardPolicy       String?   @map("award_policy")

  listing   Listing         @relation(fields: [listingId], references: [id])
  events    OfferEvent[]
  revisions OfferRevision[]

  @@index([listingId])
  @@index([customerId])
  @@map("offer")
}

// Immutable commercial proposal snapshot (E4, pack doc 08). Each proposal/counter appends a
// new revision — prior terms are NEVER overwritten; `Offer.currentRevisionId` points at the
// latest. Money is integer minor units; quantity is Decimal. Confidentiality: competitor
// revisions are never returned before a controlled reveal (enforced in the service + domain).
model OfferRevision {
  id                    String    @id
  offerId               String    @map("offer_id")
  revisionNumber        Int       @map("revision_number")
  authorType            String    @map("author_type")
  authorId              String?   @map("author_id")
  totalPriceMinor       BigInt?   @map("total_price_minor")
  unitPriceMinor        BigInt?   @map("unit_price_minor")
  currency              String    @default("LKR")
  quantity              Decimal?  @db.Decimal(38, 9)
  quantityUnitCode      String?   @map("quantity_unit_code")
  incoterm              String?
  originLocationId      String?   @map("origin_location_id")
  destinationLocationId String?   @map("destination_location_id")
  deliveryDate          DateTime? @map("delivery_date")
  deliveryWindowStart   DateTime? @map("delivery_window_start")
  deliveryWindowEnd     DateTime? @map("delivery_window_end")
  paymentTerms          String?   @map("payment_terms")
  freightResponsibility String?   @map("freight_responsibility")
  validUntil            DateTime? @map("valid_until")
  notes                 String?
  conditions            Json?
  createdAt             DateTime  @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([offerId, revisionNumber])
  @@index([offerId])
  @@map("offer_revision")
}

enum OfferEventType {
  offer
  counter
  accept
  reject
  withdraw
  expire
}

// Append-only offer/counter history (docs/07 Make Offer).
model OfferEvent {
  id          String         @id
  offerId     String         @map("offer_id")
  type        OfferEventType
  amountMinor BigInt?        @map("amount_minor")
  note        String?
  actorType   ActorType      @map("actor_type")
  actorId     String?        @map("actor_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  offer Offer @relation(fields: [offerId], references: [id])

  @@index([offerId])
  @@map("offer_event")
}

// Sealed Tender (docs/07): private submissions, revealed only on a controlled
// staff-triggered open. `openedAt` is null while sealed; competitor values are
// never returned before the open.
model TenderBid {
  id          String    @id
  listingId   String    @map("listing_id")
  customerId  String    @map("customer_id")
  amountMinor BigInt    @map("amount_minor")
  currency    String    @default("LKR")
  openedAt    DateTime? @map("opened_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([listingId, customerId])
  @@index([listingId])
  @@map("tender_bid")
}

model MediaObject {
  id         String      @id
  assetId    String      @map("asset_id")
  kind       MediaKind
  storageKey String      @map("storage_key")
  status     MediaStatus @default(uploading)
  // Originals are immutable; this stays true and is enforced by convention +
  // the derivative pointer below. Enhanced/processed media are separate rows.
  isOriginal Boolean     @default(true) @map("is_original")
  createdAt  DateTime    @default(now()) @map("created_at")

  // Presentation + processing metadata (consolidated pack doc 06/08). Additive.
  sortOrder  Int     @default(0) @map("sort_order")
  isCover    Boolean @default(false) @map("is_cover")
  caption    String?
  visibility String  @default("public")
  mimeType   String? @map("mime_type")
  sizeBytes  Int?    @map("size_bytes")
  width      Int?
  height     Int?
  durationMs Int?    @map("duration_ms")
  checksum   String?

  asset              Asset                     @relation(fields: [assetId], references: [id])
  derivatives        MediaDerivative[]
  inspectionEvidence AssetInspectionEvidence[]

  @@index([assetId])
  @@index([assetId, sortOrder])
  @@map("media_object")
}

model MediaDerivative {
  id            String   @id
  sourceMediaId String   @map("source_media_id")
  method        String
  storageKey    String   @map("storage_key")
  createdAt     DateTime @default(now()) @map("created_at")

  source MediaObject @relation(fields: [sourceMediaId], references: [id])

  @@index([sourceMediaId])
  @@map("media_derivative")
}

// ---------------------------------------------------------------------------
// Audit (docs/04, docs/15) — APPEND-ONLY business evidence. A database trigger
// (see the audit_append_only migration) rejects UPDATE and DELETE.
// ---------------------------------------------------------------------------

model AuditEvent {
  id            String    @id
  actorType     ActorType @map("actor_type")
  actorId       String?   @map("actor_id")
  action        String
  targetType    String    @map("target_type")
  targetId      String    @map("target_id")
  correlationId String    @map("correlation_id")
  reason        String?
  before        Json?
  after         Json?
  occurredAt    DateTime  @default(now()) @map("occurred_at")

  @@index([targetType, targetId])
  @@index([correlationId])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Transactional outbox + platform config (docs/16, docs/18, docs/20)
// ---------------------------------------------------------------------------

model OutboxEvent {
  id             String       @id
  eventId        String       @unique @map("event_id")
  name           String
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id")
  correlationId  String       @map("correlation_id")
  causationId    String?      @map("causation_id")
  payload        Json
  payloadVersion Int          @default(1) @map("payload_version")
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  occurredAt     DateTime     @map("occurred_at")
  dispatchedAt   DateTime?    @map("dispatched_at")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("outbox_event")
}

// Idempotency for bids/payments/purchases/publication (docs/16).
model IdempotencyRecord {
  id         String    @id
  key        String    @unique
  scope      String
  resultHash String?   @map("result_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@index([scope])
  @@map("idempotency_record")
}

model FeatureFlag {
  id          String   @id
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flag")
}

// Business config with an explicit "needs product-owner approval" marker (docs/20).
model BusinessConfig {
  id               String   @id
  key              String   @unique
  value            String
  approvalRequired Boolean  @default(true) @map("approval_required")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("business_config")
}

// ---------------------------------------------------------------------------
// Singha Evolution — configuration foundations (E2). ADDITIVE, config-only:
// these are lookup/config tables resolved at request time, NOT per-country
// ledgers (Addendum A — one authoritative datastore for binding records).
// Owner/legal-gated config (Operator/MarketNode legal identity) ships `draft`
// and is treated as MANUAL_REVIEW_REQUIRED for binding paths until verified
// (DECISIONS D7). Gated by MULTI_OPERATOR / STRUCTURED_LOCATIONS /
// QUANTITY_UNITS / SALE_METHOD_CONFIG, all default OFF.
// ---------------------------------------------------------------------------

enum UnitKind {
  count
  weight
  volume
  area
  length
}

enum OperatorType {
  company
  subsidiary
  sister_company
  trading_business
  custodian
  agent
  representative
  marketplace_operator
  local_service_company
}

// Verification state for owner/legal-gated config (DECISIONS D7). Binding methods
// that depend on `draft`/`unverified` config must return MANUAL_REVIEW_REQUIRED.
enum ConfigVerification {
  draft
  unverified
  verified
}

enum MarketNodeMode {
  DISCOVERY
  LOCAL_COMMERCE
}

// Configurable unit of measure for the quantity engine (DECISIONS D5). Conversion
// factors are added in E3 when quantity arithmetic lands (Decimal there).
model UnitDefinition {
  id        String   @id
  code      String   @unique
  label     String
  plural    String?
  kind      UnitKind
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("unit_definition")
}

// Configurable sale-method taxonomy (DECISIONS D3): the app moves off the fixed
// `SaleMethod` enum onto these codes additively. `legacyEnum` maps a definition to
// the existing enum value during migration. `bindsAutomatically` is FALSE for every
// sealed/offer method (DECISIONS D4 — no silent auto-award of the highest proposal).
model SaleMethodDefinition {
  id                  String      @id
  code                String      @unique
  label               String
  family              String
  isAuction           Boolean     @default(false) @map("is_auction")
  bindsAutomatically  Boolean     @default(false) @map("binds_automatically")
  requiresEligibility Boolean     @default(false) @map("requires_eligibility")
  legacyEnum          SaleMethod? @map("legacy_enum")
  active              Boolean     @default(true)
  sortOrder           Int         @default(0) @map("sort_order")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  @@map("sale_method_definition")
}

// A market / jurisdiction (e.g. Sri Lanka, Australia, India). Config only.
model Market {
  id              String   @id
  code            String   @unique
  name            String
  countryCode     String   @map("country_code")
  defaultCurrency String   @map("default_currency")
  defaultLanguage String?  @map("default_language")
  defaultTimezone String?  @map("default_timezone")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  operators OperatorMarket[]
  nodes     MarketNode[]

  @@map("market")
}

// A configurable legal/routing operator (pack 07) — NOT equal to Organization.
// Legal identity is owner-gated (register O1): `verification` stays `draft` until
// confirmed; binding paths requiring an unverified operator return MANUAL_REVIEW_REQUIRED.
model Operator {
  id           String             @id
  code         String             @unique
  publicName   String             @map("public_name")
  legalName    String?            @map("legal_name")
  type         OperatorType       @default(marketplace_operator)
  verification ConfigVerification @default(draft)
  disclosure   String?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  markets  OperatorMarket[]
  nodes    MarketNodeOperator[]
  listings Listing[]

  @@map("operator")
}

model OperatorMarket {
  id         String @id
  operatorId String @map("operator_id")
  marketId   String @map("market_id")

  operator Operator @relation(fields: [operatorId], references: [id])
  market   Market   @relation(fields: [marketId], references: [id])

  @@unique([operatorId, marketId])
  @@index([marketId])
  @@map("operator_market")
}

// First-class structured location (pack 15). The role wiring on Listing
// (asset/seller/custodian/pickup/export-origin/destination) lands additively in E3;
// coordinates use Decimal there. Central table — never a per-node copy (Addendum A).
model Location {
  id          String   @id
  countryCode String   @map("country_code")
  region      String?
  city        String?
  locality    String?
  addressLine String?  @map("address_line")
  postalCode  String?  @map("postal_code")
  visibility  String   @default("public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Listing role back-relations (E3) — one Location may fill many roles across listings.
  assetListings        Listing[] @relation("ListingAssetLocation")
  sellerListings       Listing[] @relation("ListingSellerLocation")
  custodianListings    Listing[] @relation("ListingCustodianLocation")
  pickupListings       Listing[] @relation("ListingPickupLocation")
  exportOriginListings Listing[] @relation("ListingExportOriginLocation")
  destinationListings  Listing[] @relation("ListingDestinationLocation")

  @@index([countryCode])
  @@map("location")
}

// Satellite Market Node (Addendum A): a configurable presentation + origination +
// local-routing surface, NOT a system of record. In BOTH modes all binding state
// uses the central canonical records; a node is data resolved at request time.
// Local-commerce capabilities are gated + owner-verified before any binding use.
model MarketNode {
  id                     String             @id
  code                   String             @unique
  name                   String
  mode                   MarketNodeMode     @default(DISCOVERY)
  primaryMarketId        String?            @map("primary_market_id")
  defaultCurrency        String?            @map("default_currency")
  defaultLanguage        String?            @map("default_language")
  defaultLocationCountry String?            @map("default_location_country")
  canOriginateListings   Boolean            @default(false) @map("can_originate_listings")
  canTakeOffers          Boolean            @default(false) @map("can_take_offers")
  canRunAuctions         Boolean            @default(false) @map("can_run_auctions")
  canAcceptPayments      Boolean            @default(false) @map("can_accept_payments")
  verification           ConfigVerification @default(draft)
  active                 Boolean            @default(true)
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  primaryMarket Market?              @relation(fields: [primaryMarketId], references: [id])
  operators     MarketNodeOperator[]
  listings      Listing[]

  @@index([primaryMarketId])
  @@map("market_node")
}

model MarketNodeOperator {
  id         String @id
  nodeId     String @map("node_id")
  operatorId String @map("operator_id")

  node     MarketNode @relation(fields: [nodeId], references: [id])
  operator Operator   @relation(fields: [operatorId], references: [id])

  @@unique([nodeId, operatorId])
  @@index([operatorId])
  @@map("market_node_operator")
}

// ---------------------------------------------------------------------------
// Auction engine (docs/07) — server-authoritative. UI is never the source of
// truth. The Bid ledger is append-only (a DB trigger rejects UPDATE/DELETE);
// corrections are new reversal rows. Proxy maximums are PRIVATE and never
// exposed. Money is integer minor units.
// ---------------------------------------------------------------------------

enum AuctionStatus {
  scheduled
  open
  paused
  closed
  cancelled
}

enum BidSource {
  online
  floor
  phone
  absentee
  proxy
  auctioneer
}

enum BidStatus {
  accepted
  rejected
  reversed
}

model Auction {
  id                  String        @id
  listingId           String        @unique @map("listing_id")
  status              AuctionStatus @default(scheduled)
  currency            String        @default("LKR")
  startsAt            DateTime      @map("starts_at")
  endsAt              DateTime      @map("ends_at")
  openingBidMinor     BigInt        @map("opening_bid_minor")
  reserveMinor        BigInt?       @map("reserve_minor")
  reserveVisible      Boolean       @default(false) @map("reserve_visible")
  incrementMinor      BigInt        @map("increment_minor")
  softCloseTriggerSec Int           @default(10) @map("soft_close_trigger_sec")
  softCloseExtendSec  Int           @default(20) @map("soft_close_extend_sec")
  buyerPremiumPct     Float         @default(0) @map("buyer_premium_pct")
  // Denormalized realtime projection (rebuildable from the ledger).
  currentBidMinor     BigInt?       @map("current_bid_minor")
  highBidderId        String?       @map("high_bidder_id")
  highBidId           String?       @map("high_bid_id")
  extendedCount       Int           @default(0) @map("extended_count")
  version             Int           @default(0)
  winnerCustomerId    String?       @map("winner_customer_id")
  soldAt              DateTime?     @map("sold_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  listing Listing     @relation(fields: [listingId], references: [id])
  bids    Bid[]
  maxes   BidderMax[]

  @@index([status, endsAt])
  @@map("auction")
}

// Append-only bid ledger (docs/04). Each visible price the engine sets is a row.
model Bid {
  id             String    @id
  auctionId      String    @map("auction_id")
  sequence       Int
  bidderId       String    @map("bidder_id")
  amountMinor    BigInt    @map("amount_minor")
  source         BidSource @default(online)
  status         BidStatus @default(accepted)
  idempotencyKey String?   @map("idempotency_key")
  placedAt       DateTime  @default(now()) @map("placed_at")

  auction Auction @relation(fields: [auctionId], references: [id])

  @@unique([auctionId, sequence])
  @@index([auctionId])
  @@map("bid")
}

// Private per-bidder proxy maximum (never exposed to other bidders / analytics).
model BidderMax {
  id        String   @id
  auctionId String   @map("auction_id")
  bidderId  String   @map("bidder_id")
  maxMinor  BigInt   @map("max_minor")
  updatedAt DateTime @updatedAt @map("updated_at")

  auction Auction @relation(fields: [auctionId], references: [id])

  @@unique([auctionId, bidderId])
  @@index([auctionId])
  @@map("bidder_max")
}

enum EoiStatus {
  submitted
  under_review
  shortlisted
  negotiating
  accepted
  declined
  withdrawn
  expired
}

// Expression of Interest (docs/07). A PRIVATE structured submission: amount,
// message and conditions are visible only to the submitter and authorised
// staff, never to competing bidders. Status changes are appended to EoiEvent.
model Eoi {
  id          String    @id
  listingId   String    @map("listing_id")
  customerId  String    @map("customer_id")
  status      EoiStatus @default(submitted)
  amountMinor BigInt?   @map("amount_minor")
  currency    String    @default("LKR")
  message     String?
  conditions  String?
  expiresAt   DateTime? @map("expires_at")
  reviewNote  String?   @map("review_note")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  listing Listing    @relation(fields: [listingId], references: [id])
  events  EoiEvent[]

  @@index([listingId])
  @@index([customerId])
  @@index([status])
  @@map("eoi")
}

// Append-only status history for an EOI (immutable audit of negotiation).
model EoiEvent {
  id         String    @id
  eoiId      String    @map("eoi_id")
  fromStatus EoiStatus @map("from_status")
  toStatus   EoiStatus @map("to_status")
  note       String?
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  eoi Eoi @relation(fields: [eoiId], references: [id])

  @@index([eoiId])
  @@map("eoi_event")
}

// ---------------------------------------------------------------------------
// Commerce (docs/14) — invoice, append-only financial ledger, payment, release,
// fulfilment and seller settlement. A won/accepted listing is NOT a completed
// transaction; the platform continues through this pipeline.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  issued
  paid
  void
}

model Invoice {
  id                  String        @id
  number              String        @unique
  listingId           String        @unique @map("listing_id")
  saleId              String        @map("sale_id")
  buyerCustomerId     String        @map("buyer_customer_id")
  currency            String        @default("LKR")
  hammerMinor         BigInt        @map("hammer_minor")
  buyerPremiumMinor   BigInt        @map("buyer_premium_minor")
  taxMinor            BigInt        @map("tax_minor")
  otherFeesMinor      BigInt        @default(0) @map("other_fees_minor")
  depositAppliedMinor BigInt        @default(0) @map("deposit_applied_minor")
  amountDueMinor      BigInt        @map("amount_due_minor")
  status              InvoiceStatus @default(issued)
  dueAt               DateTime      @map("due_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  listing  Listing       @relation(fields: [listingId], references: [id])
  payments Payment[]
  ledger   LedgerEntry[]

  @@index([buyerCustomerId])
  @@map("invoice")
}

enum LedgerEntryType {
  deposit_received
  sale_charge
  buyer_premium
  tax
  payment_received
  refund
  credit_applied
  settlement_disbursed
}

// APPEND-ONLY financial ledger (docs/14). We never model a mutable balance;
// every money movement is an immutable event. A DB trigger rejects UPDATE/DELETE.
model LedgerEntry {
  id          String          @id
  listingId   String          @map("listing_id")
  invoiceId   String?         @map("invoice_id")
  entryType   LedgerEntryType @map("entry_type")
  amountMinor BigInt          @map("amount_minor")
  currency    String          @default("LKR")
  reference   String?
  actorType   ActorType       @map("actor_type")
  actorId     String?         @map("actor_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([listingId])
  @@index([invoiceId])
  @@map("ledger_entry")
}

enum PaymentStatus {
  pending_verification
  confirmed
  rejected
}

// Manual bank transfer flow (docs/14): uploading proof is NEVER equivalent to
// being paid — staff/accounts verify, then a ledger event records confirmation.
model Payment {
  id          String        @id
  invoiceId   String        @map("invoice_id")
  amountMinor BigInt        @map("amount_minor")
  method      String        @default("bank_transfer")
  status      PaymentStatus @default(pending_verification)
  proofRef    String?       @map("proof_ref")
  verifiedBy  String?       @map("verified_by")
  verifiedAt  DateTime?     @map("verified_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payment")
}

enum FulfilmentState {
  payment_pending
  payment_confirmed
  release_approved
  ready_for_pickup
  pickup_booked
  in_delivery
  collected
  delivered
  completed
}

model Fulfilment {
  id         String          @id
  listingId  String          @unique @map("listing_id")
  state      FulfilmentState @default(payment_pending)
  releaseRef String?         @map("release_ref")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@map("fulfilment")
}

model Settlement {
  id                 String   @id
  listingId          String   @unique @map("listing_id")
  saleProceedsMinor  BigInt   @map("sale_proceeds_minor")
  commissionMinor    BigInt   @map("commission_minor")
  commissionTaxMinor BigInt   @map("commission_tax_minor")
  deductionsMinor    BigInt   @default(0) @map("deductions_minor")
  netMinor           BigInt   @map("net_minor")
  reference          String?
  reason             String?
  createdAt          DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@map("settlement")
}

// ---------------------------------------------------------------------------
// Singha Connect (docs/09) — omnichannel: ONE customer identity + conversation
// history across channels. Providers live behind adapters; channel windows/
// templates are adapter config, never customer core tables.
// ---------------------------------------------------------------------------

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  inbound
  outbound
}

// Who/what produced a message (AI is always a distinct, auditable provenance).
enum MessageProvenance {
  customer
  staff
  ai
  system
}

model Conversation {
  id               String             @id
  customerId       String?            @map("customer_id")
  channel          ChannelType
  externalThreadId String             @map("external_thread_id")
  status           ConversationStatus @default(open)
  aiMode           Boolean            @default(true) @map("ai_mode")
  assignedAgentId  String?            @map("assigned_agent_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  messages Message[]

  @@unique([channel, externalThreadId])
  @@index([customerId])
  @@map("conversation")
}

model Message {
  id                String            @id
  conversationId    String            @map("conversation_id")
  direction         MessageDirection
  providerMessageId String?           @map("provider_message_id")
  sender            String?
  text              String?
  payload           Json?
  provenance        MessageProvenance @default(customer)
  createdAt         DateTime          @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("message")
}

// Messaging-channel bidding (docs/07, rule 11): free text creates a BID INTENT,
// never a bid. An accepted bid requires explicit confirmation + auction-engine
// validation. The intent is signed/idempotent and single-use.
enum BidIntentStatus {
  pending
  confirmed
  placed
  rejected
  expired
}

model BidIntent {
  id             String          @id
  customerId     String          @map("customer_id")
  auctionId      String          @map("auction_id")
  maxAmountMinor BigInt          @map("max_amount_minor")
  channel        ChannelType     @default(web)
  status         BidIntentStatus @default(pending)
  bidId          String?         @map("bid_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  confirmedAt    DateTime?       @map("confirmed_at")

  @@index([customerId])
  @@index([auctionId])
  @@map("bid_intent")
}

// ---------------------------------------------------------------------------
// Singha AI Core (docs/10) — AI outputs are DERIVED records (rule 3): they never
// overwrite original facts/media/bids/finance. Every AI invocation is recorded
// with provenance for governance; a human explicitly APPLIES a draft.
// ---------------------------------------------------------------------------

enum AiTaskType {
  listing_draft
  media_caption
  assistant
  translation
  recommendation
  support
}

model AiRun {
  id          String     @id
  taskType    AiTaskType @map("task_type")
  model       String
  provider    String     @default("mock")
  actorId     String?    @map("actor_id")
  subjectType String?    @map("subject_type")
  subjectId   String?    @map("subject_id")
  prompt      String?
  output      Json
  confidence  Float?
  applied     Boolean    @default(false)
  appliedBy   String?    @map("applied_by")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([subjectType, subjectId])
  @@index([taskType])
  @@map("ai_run")
}

// ---------------------------------------------------------------------------
// Singha Social Publisher (docs/11) — AI-assisted Facebook/Instagram creatives
// and campaigns. Publication records are their own data; publishing goes through
// an adapter (mock until Meta access). Publishing never mutates auction facts.
// ---------------------------------------------------------------------------

enum SocialPlatform {
  facebook
  instagram
}

enum SocialPublicationStatus {
  draft
  scheduled
  published
  failed
  // Approval lifecycle (docs/11 "human approval" gate): a draft/scheduled post
  // is submitted, then a human with `social:approve` approves or rejects it.
  // publish() requires `approved` — additive values, existing rows unaffected.
  pending_approval
  approved
}

enum SocialCampaignType {
  individual
  group
}

model SocialCampaign {
  id        String             @id
  name      String
  type      SocialCampaignType @default(individual)
  createdAt DateTime           @default(now()) @map("created_at")

  publications SocialPublication[]

  @@map("social_campaign")
}

model SocialPublication {
  id             String                  @id
  listingId      String?                 @map("listing_id")
  campaignId     String?                 @map("campaign_id")
  platform       SocialPlatform
  status         SocialPublicationStatus @default(draft)
  caption        String
  creativeRef    String?                 @map("creative_ref")
  aiRunId        String?                 @map("ai_run_id")
  externalPostId String?                 @map("external_post_id")
  scheduledAt    DateTime?               @map("scheduled_at")
  publishedAt    DateTime?               @map("published_at")
  // Who/when approved this post (docs/11) — set only by approve(); a derived
  // provenance record, never a substitute for the append-only audit trail.
  approvedById   String?                 @map("approved_by_id")
  approvedAt     DateTime?               @map("approved_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  campaign SocialCampaign? @relation(fields: [campaignId], references: [id])

  @@index([listingId])
  @@index([campaignId])
  @@index([status])
  @@map("social_publication")
}

// ---------------------------------------------------------------------------
// Singha Live (docs/08) — live/hybrid auction broadcast. The ingest/simulcast
// providers are behind an adapter (mock until IVS/YouTube access). Live/floor/
// phone bids all enter the ONE authoritative bid ledger via the auction engine.
// ---------------------------------------------------------------------------

enum LiveStatus {
  scheduled
  live
  paused
  ended
}

model LiveEvent {
  id             String     @id
  auctionId      String?    @map("auction_id")
  title          String
  status         LiveStatus @default(scheduled)
  ingestProvider String     @default("mock") @map("ingest_provider")
  ingestUrl      String?    @map("ingest_url")
  playbackUrl    String?    @map("playback_url")
  simulcastUrl   String?    @map("simulcast_url")
  recordingUrl   String?    @map("recording_url")
  startedAt      DateTime?  @map("started_at")
  endedAt        DateTime?  @map("ended_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([auctionId])
  @@map("live_event")
}

// ---------------------------------------------------------------------------
// Member identity, credit, security & performance engine (Revision 05).
// Additive-only. One durable Customer can be Buyer, Seller or Both; membership,
// KYC, credit facility, bidding eligibility and performance are SEPARATE concerns.
// Only verified, eligible security supports credit. The 5% security ratio is
// configuration (basis points). Exposure is enforced transactionally. Internal
// performance/flags are private, deterministic and auditable. Money is BigInt
// minor units — never floats.
// ---------------------------------------------------------------------------

enum MembershipStatus {
  pending
  temporary
  active
  suspended
  blocked
  expired
}

enum GrantScopeType {
  platform
  event
  auction
  category
}

enum AccessGrantStatus {
  active
  expired
  revoked
}

enum SecurityInstrumentType {
  cash_deposit
  bank_guarantee
  spot_deposit
}

enum SecurityInstrumentStatus {
  pending_verification
  verified
  active
  expired
  release_pending
  released
  rejected
  cancelled
}

enum CreditFacilityStatus {
  pending
  active
  review_required
  suspended
  expired
  closed
}

enum CreditDecisionType {
  calculate
  approve
  cap
  uplift
  suspend
  reactivate
  close
  override
}

enum CreditReservationStatus {
  active
  released
  converted
}

enum PerformanceContext {
  buyer
  seller
}

enum MemberFlagContext {
  buyer
  seller
  general
}

enum MemberFlagSeverity {
  low
  medium
  high
  critical
}

enum MemberFlagStatus {
  open
  under_review
  resolved
  dismissed
  expired
}

// Membership lifecycle — one active row projects the customer's current state.
model Membership {
  id          String           @id
  customerId  String           @map("customer_id")
  status      MembershipStatus @default(pending)
  activatedAt DateTime?        @map("activated_at")
  suspendedAt DateTime?        @map("suspended_at")
  blockedAt   DateTime?        @map("blocked_at")
  expiresAt   DateTime?        @map("expires_at")
  reason      String?
  createdBy   String?          @map("created_by")
  updatedBy   String?          @map("updated_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("membership")
}

// Temporary / event-scoped access granted after an approved spot deposit.
model MembershipAccessGrant {
  id                   String            @id
  customerId           String            @map("customer_id")
  scopeType            GrantScopeType    @map("scope_type")
  scopeId              String?           @map("scope_id")
  startsAt             DateTime          @map("starts_at")
  expiresAt            DateTime          @map("expires_at")
  securityInstrumentId String?           @map("security_instrument_id")
  creditFacilityId     String?           @map("credit_facility_id")
  grantedBy            String?           @map("granted_by")
  reason               String?
  status               AccessGrantStatus @default(active)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([scopeType, scopeId])
  @@index([status])
  @@map("membership_access_grant")
}

// First-class security instruments. Only verified/active, non-expired, eligible
// instruments support new credit. Bank-guarantee documents are private.
model SecurityInstrument {
  id                  String                   @id
  customerId          String                   @map("customer_id")
  organizationId      String?                  @map("organization_id")
  type                SecurityInstrumentType
  currency            String                   @default("LKR")
  faceAmountMinor     BigInt                   @map("face_amount_minor")
  eligibleAmountMinor BigInt                   @default(0) @map("eligible_amount_minor")
  // Eligibility factor in basis points (10000 = 1.00; a haircut lowers it).
  eligibilityBps      Int                      @default(10000) @map("eligibility_bps")
  status              SecurityInstrumentStatus @default(pending_verification)
  reference           String?
  issuingBank         String?                  @map("issuing_bank")
  guaranteeNumber     String?                  @map("guarantee_number")
  issueDate           DateTime?                @map("issue_date")
  expiresAt           DateTime?                @map("expires_at")
  documentMediaId     String?                  @map("document_media_id")
  verifiedAt          DateTime?                @map("verified_at")
  verifiedBy          String?                  @map("verified_by")
  releasedAt          DateTime?                @map("released_at")
  releasedBy          String?                  @map("released_by")
  notes               String?
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  customer           Customer                 @relation(fields: [customerId], references: [id])
  organization       Organization?            @relation(fields: [organizationId], references: [id])
  facilitySecurities CreditFacilitySecurity[]

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
  @@map("security_instrument")
}

// Standing credit facility. calculated / approved / uplift are stored separately
// so overrides never overwrite the policy calculation.
model CreditFacility {
  id                       String               @id
  customerId               String               @map("customer_id")
  currency                 String               @default("LKR")
  scopeType                GrantScopeType       @default(platform) @map("scope_type")
  scopeId                  String?              @map("scope_id")
  calculatedBaseLimitMinor BigInt               @default(0) @map("calculated_base_limit_minor")
  approvedLimitMinor       BigInt               @default(0) @map("approved_limit_minor")
  temporaryUpliftMinor     BigInt               @default(0) @map("temporary_uplift_minor")
  status                   CreditFacilityStatus @default(pending)
  // Configurable required-security ratio in basis points (500 = 5.00%).
  requiredSecurityBps      Int                  @default(500) @map("required_security_bps")
  policyVersion            String               @default("credit-v1") @map("policy_version")
  startsAt                 DateTime             @default(now()) @map("starts_at")
  expiresAt                DateTime?            @map("expires_at")
  approvedBy               String?              @map("approved_by")
  approvalReason           String?              @map("approval_reason")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")

  customer     Customer                 @relation(fields: [customerId], references: [id])
  securities   CreditFacilitySecurity[]
  decisions    CreditDecision[]
  reservations CreditReservation[]

  @@index([customerId])
  @@index([status])
  @@map("credit_facility")
}

// Join: which verified security instruments support a facility.
model CreditFacilitySecurity {
  id                   String   @id
  facilityId           String   @map("facility_id")
  securityInstrumentId String   @map("security_instrument_id")
  createdAt            DateTime @default(now()) @map("created_at")

  facility CreditFacility     @relation(fields: [facilityId], references: [id])
  security SecurityInstrument @relation(fields: [securityInstrumentId], references: [id])

  @@unique([facilityId, securityInstrumentId])
  @@index([securityInstrumentId])
  @@map("credit_facility_security")
}

// Append-only credit decision history — prior decisions are never overwritten.
model CreditDecision {
  id                 String             @id
  facilityId         String             @map("facility_id")
  decisionType       CreditDecisionType @map("decision_type")
  previousLimitMinor BigInt?            @map("previous_limit_minor")
  newLimitMinor      BigInt?            @map("new_limit_minor")
  reason             String?
  decidedBy          String?            @map("decided_by")
  secondApprover     String?            @map("second_approver")
  policyVersion      String?            @map("policy_version")
  createdAt          DateTime           @default(now()) @map("created_at")

  facility CreditFacility @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@map("credit_decision")
}

// Authoritative exposure record. active reservations are committed exposure;
// available = effectiveApprovedLimit − sum(active reservations).
model CreditReservation {
  id                String                  @id
  customerId        String                  @map("customer_id")
  facilityId        String                  @map("facility_id")
  sourceType        String                  @map("source_type")
  sourceId          String                  @map("source_id")
  amountMinor       BigInt                  @map("amount_minor")
  currency          String                  @default("LKR")
  status            CreditReservationStatus @default(active)
  convertedToSaleId String?                 @map("converted_to_sale_id")
  releasedAt        DateTime?               @map("released_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  customer Customer       @relation(fields: [customerId], references: [id])
  facility CreditFacility @relation(fields: [facilityId], references: [id])

  // One live reservation per (customer, source) — re-bidding updates in place.
  @@unique([sourceType, sourceId])
  @@index([customerId, status])
  @@index([facilityId, status])
  @@map("credit_reservation")
}

// Objective, append-only performance events. Internal, separated from permanent
// customer facts; the deterministic rule engine folds these into snapshots.
model PerformanceEvent {
  id               String             @id
  customerId       String             @map("customer_id")
  context          PerformanceContext
  eventType        String             @map("event_type")
  dimension        String
  value            Float              @default(1)
  sourceEntityType String?            @map("source_entity_type")
  sourceEntityId   String?            @map("source_entity_id")
  occurredAt       DateTime           @default(now()) @map("occurred_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, context])
  @@map("performance_event")
}

// Rebuildable performance snapshot — score/band + component breakdown + rule
// version. score is null for INSUFFICIENT_HISTORY.
model PerformanceSnapshot {
  id          String             @id
  customerId  String             @map("customer_id")
  context     PerformanceContext
  score       Int?
  band        String
  ruleVersion String             @map("rule_version")
  components  Json               @default("{}")
  generatedAt DateTime           @default(now()) @map("generated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, context])
  @@map("performance_snapshot")
}

// Structured internal review / caution flag. Private, role-restricted, auditable.
// Never a single free-text blacklist field; resolution preserves history.
model MemberFlag {
  id          String             @id
  customerId  String             @map("customer_id")
  context     MemberFlagContext  @default(general)
  category    String
  severity    MemberFlagSeverity @default(low)
  status      MemberFlagStatus   @default(open)
  reasonCode  String             @map("reason_code")
  title       String
  privateNote String?            @map("private_note")
  evidence    Json               @default("[]")
  createdBy   String?            @map("created_by")
  reviewedBy  String?            @map("reviewed_by")
  resolvedBy  String?            @map("resolved_by")
  resolvedAt  DateTime?          @map("resolved_at")
  expiresAt   DateTime?          @map("expires_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, status])
  @@map("member_flag")
}

// ---------------------------------------------------------------------------
// V3 — Singha Discover + Buyer Twin (pack docs 06/11). Additive, rebuildable.
// The append-only DiscoveryEvent ledger is the durable preference record; the
// BuyerTwinProjection is a DROPPABLE cache recomputed by the engine. `eventType`
// and `sourceSurface` are stored as text validated by the @singha/contracts zod
// enums at the API boundary. `metadata` is a strict primitive allow-list — never
// raw device fingerprints or sensitive traits.
// ---------------------------------------------------------------------------

model DiscoveryEvent {
  id                 String   @id
  customerId         String?  @map("customer_id")
  anonymousSessionId String?  @map("anonymous_session_id")
  listingId          String   @map("listing_id")
  eventType          String   @map("event_type")
  sourceSurface      String   @default("FLOW") @map("source_surface")
  bandContext        String?  @map("band_context")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id])
  listing  Listing   @relation(fields: [listingId], references: [id])

  @@index([customerId, createdAt])
  @@index([anonymousSessionId, createdAt])
  @@index([listingId])
  @@map("discovery_event")
}

// One rebuildable projection per customer. `data` is the internal (Tier-A) projection
// JSON and is NEVER served raw — the API maps it to the safe BuyerTwinSummary.
model BuyerTwinProjection {
  customerId  String   @id @map("customer_id")
  version     Int
  data        Json
  builtAt     DateTime @map("built_at")
  signalCount Int      @map("signal_count")

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("buyer_twin_projection")
}

// Measures whether a recommendation was shown (so we can avoid repeating it and
// later measure effectiveness). FK-less analytics log.
model RecommendationImpression {
  id         String   @id
  customerId String?  @map("customer_id")
  listingId  String   @map("listing_id")
  surface    String   @default("DISCOVER")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId, listingId])
  @@map("recommendation_impression")
}

// Engagement notification preferences (pack doc 05). One row per customer. The
// consent/quiet-hours/frequency POLICY lives in the domain engine; this is durable
// customer preference state only. Money-free, PII-light.
model NotificationPreference {
  customerId            String   @id @map("customer_id")
  channels              Json     @default("{\"in_app\":true,\"push\":false,\"email\":true,\"sms\":false,\"whatsapp\":false}")
  engagementOptIn       Boolean  @default(false) @map("engagement_opt_in")
  quietStartMinute      Int?     @map("quiet_start_minute")
  quietEndMinute        Int?     @map("quiet_end_minute")
  timezoneOffsetMinutes Int      @default(0) @map("timezone_offset_minutes")
  frequencyCapPerDay    Int      @default(8) @map("frequency_cap_per_day")
  mutedCategories       String[] @default([]) @map("muted_categories")
  updatedAt             DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

// Append-only delivery ledger (pack doc 05). Every dispatch decision is recorded:
// a send (per channel), a suppression (with reason), a transient failure, or a
// dead-lettered give-up. Never mutated destructively — status transitions append.
model NotificationDelivery {
  id                String   @id
  customerId        String   @map("customer_id")
  eventType         String   @map("event_type")
  classification    String
  channel           String?
  status            String
  suppressedReason  String?  @map("suppressed_reason")
  dedupeKey         String   @map("dedupe_key")
  title             String
  body              String
  providerMessageId String?  @map("provider_message_id")
  attempts          Int      @default(0)
  lastError         String?  @map("last_error")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([status])
  @@map("notification_delivery")
}

// Privacy-safe product analytics for the V3 dashboard pilot (pack doc 08/09). An
// append-only, PII-light instrumentation log: which surfaces are opened, which actions
// complete, and Discover→watch→bid funnel steps — so V3-11 can refine from evidence.
// FK-less analytics (customerId is a bare column, nullable for anonymous).
model ProductEvent {
  id                 String   @id
  customerId         String?  @map("customer_id")
  anonymousSessionId String?  @map("anonymous_session_id")
  surface            String
  action             String
  listingId          String?  @map("listing_id")
  funnelStep         String?  @map("funnel_step")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([surface, createdAt])
  @@index([customerId, createdAt])
  @@map("product_event")
}

// Immutable FX rate snapshot (Evolution E5, pack docs 09/10; DECISIONS D5 + D12). The record a
// display conversion returns and a binding calculation (E6/E8) embeds — base/quote/rate/provider/
// quotedAt/expiry/margin. `rate` is stored as its exact decimal string (quote units per 1 base
// unit; never a float — the authoritative math parses it to a 10^9-scaled integer). Also serves
// as the rate cache: a fresh row (now < expiresAt) is reused instead of re-quoting the provider.
model FxRateSnapshot {
  id        String   @id
  base      String
  quote     String
  rate      String
  provider  String
  marginBps Int      @default(0) @map("margin_bps")
  quotedAt  DateTime @map("quoted_at")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([base, quote, provider, quotedAt])
  @@map("fx_rate_snapshot")
}

// Transaction Routing rule (Evolution E6, pack doc 07). Deterministic, versioned config the
// Routing Engine matches over — NO country if/else forest. NULL condition = wildcard. An
// unverified rule resolves only as a non-binding PREVIEW (DECISIONS D7). Owner-gated config.
model RoutingRule {
  id                      String             @id
  code                    String
  version                 Int                @default(1)
  priority                Int                @default(0)
  active                  Boolean            @default(true)
  // Match conditions (null = wildcard).
  saleMethodCode          String?            @map("sale_method_code")
  category                String?
  marketCode              String?            @map("market_code")
  jurisdiction            String?
  operatorCode            String?            @map("operator_code")
  originNodeCode          String?            @map("origin_node_code")
  destinationCountry      String?            @map("destination_country")
  // Resolution outputs.
  transactionOperatorCode String?            @map("transaction_operator_code")
  paymentRouteCode        String?            @map("payment_route_code")
  termsCode               String?            @map("terms_code")
  disclosure              String?
  requiresKyc             Boolean            @default(false) @map("requires_kyc")
  requiresLicence         Boolean            @default(false) @map("requires_licence")
  verification            ConfigVerification @default(draft)
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  @@unique([code, version])
  @@index([active])
  @@map("routing_rule")
}

// Two-layer Terms document (Evolution E6, pack doc 07). `layer` is PLATFORM or TRANSACTION.
// Transaction terms resolve by operator/jurisdiction/category/method (null = wildcard). The legal
// wording itself stays owner/legal-reviewed content referenced by `bodyRef` — Claude never invents
// law (DECISIONS D7); an unverified document binds only after owner verification.
model TermsDocument {
  id             String             @id
  code           String
  version        Int                @default(1)
  layer          String
  operatorCode   String?            @map("operator_code")
  jurisdiction   String?
  category       String?
  saleMethodCode String?            @map("sale_method_code")
  bodyRef        String?            @map("body_ref")
  verification   ConfigVerification @default(draft)
  active         Boolean            @default(true)
  effectiveFrom  DateTime?          @map("effective_from")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([code, version])
  @@index([layer, active])
  @@map("terms_document")
}

// Persisted routing decision snapshot (Evolution E6; Addendum A — routing input + persistence).
// An explainable audit record of what the engine resolved for a given transaction shape, incl. the
// matched rule + version and the RESOLVED / MANUAL_REVIEW_REQUIRED outcome. Append-only.
model RoutingDecision {
  id                      String   @id
  status                  String
  saleMethodCode          String?  @map("sale_method_code")
  matchedRuleCode         String?  @map("matched_rule_code")
  matchedRuleVersion      Int?     @map("matched_rule_version")
  transactionOperatorCode String?  @map("transaction_operator_code")
  paymentRouteCode        String?  @map("payment_route_code")
  termsCode               String?  @map("terms_code")
  reason                  String?
  input                   Json?
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("routing_decision")
}

// Logistics node (Evolution E7, pack doc 10) — a neutral port / airport / inland depot / pickup
// site. `kind` is PORT | AIRPORT | INLAND_DEPOT | PICKUP_SITE. Owner-configurable master data.
model LogisticsNode {
  id          String   @id
  code        String   @unique
  name        String
  kind        String
  countryCode String?  @map("country_code")
  city        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([kind, active])
  @@map("logistics_node")
}

// Logistics provider (Evolution E7, pack doc 10). Live quotes await owner register O6; until then
// a credential-free fake supplies deterministic estimates. `modes` lists supported transport modes.
model LogisticsProvider {
  id           String             @id
  code         String             @unique
  name         String
  modes        Json?
  active       Boolean            @default(true)
  verification ConfigVerification @default(draft)
  createdAt    DateTime           @default(now()) @map("created_at")

  @@map("logistics_provider")
}

// Logistics quote (Evolution E7, pack doc 10). A quote is NOT a booking: it persists its
// assumptions, provider and expiry, and money stays in integer minor units (D5). A booking (E7b)
// references an accepted, still-fresh quote.
model LogisticsQuote {
  id                  String   @id
  originNodeCode      String   @map("origin_node_code")
  destinationNodeCode String   @map("destination_node_code")
  transportMode       String   @map("transport_mode")
  incoterm            String
  freightArranger     String   @map("freight_arranger")
  chargeableUnits     Int      @map("chargeable_units")
  amountMinor         BigInt   @map("amount_minor")
  currency            String   @default("LKR")
  provider            String
  assumptions         Json?
  status              String   @default("QUOTED")
  quotedAt            DateTime @map("quoted_at")
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  booking LogisticsBooking?

  @@index([status, createdAt])
  @@map("logistics_quote")
}

// Logistics booking (Evolution E7b, pack doc 10). A booking references an accepted, still-fresh
// quote and SNAPSHOTS its commercial terms (a quote is not a booking). One booking per quote.
model LogisticsBooking {
  id                  String   @id
  quoteId             String   @unique @map("quote_id")
  originNodeCode      String   @map("origin_node_code")
  destinationNodeCode String   @map("destination_node_code")
  transportMode       String   @map("transport_mode")
  incoterm            String
  freightArranger     String   @map("freight_arranger")
  amountMinor         BigInt   @map("amount_minor")
  currency            String   @default("LKR")
  provider            String
  bookedByCustomerId  String?  @map("booked_by_customer_id")
  createdAt           DateTime @default(now()) @map("created_at")

  quote    LogisticsQuote     @relation(fields: [quoteId], references: [id])
  shipment LogisticsShipment?

  @@map("logistics_booking")
}

// Logistics shipment (Evolution E7b, pack doc 10). Created from a booking; moves through an
// append-only event timeline. `status` follows the domain shipment state machine.
model LogisticsShipment {
  id        String   @id
  bookingId String   @unique @map("booking_id")
  status    String   @default("BOOKED")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking LogisticsBooking         @relation(fields: [bookingId], references: [id])
  events  LogisticsShipmentEvent[]

  @@map("logistics_shipment")
}

// Append-only shipment event (Evolution E7b). `status` is set when the event advances the
// shipment (validated against the lifecycle); otherwise it is an informational timeline note.
model LogisticsShipmentEvent {
  id           String   @id
  shipmentId   String   @map("shipment_id")
  type         String
  status       String?
  note         String?
  locationCode String?  @map("location_code")
  occurredAt   DateTime @default(now()) @map("occurred_at")

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@map("logistics_shipment_event")
}

// Fee/tax rule (Evolution E8, pack doc 10). Versioned, configurable charge rule the fees engine
// resolves per component (most-specific wins). `component`/`side`/`basis` are the taxonomy;
// `appliesTo` is PRINCIPAL or BUYER_SUBTOTAL (for tax). Tax rule *values* are owner-gated (O3):
// an unverified rule yields a non-binding preview. Old transactions stay reproducible because each
// computed line snapshots the applied rule code+version+rate.
model FeeRule {
  id                String             @id
  code              String
  version           Int                @default(1)
  priority          Int                @default(0)
  active            Boolean            @default(true)
  component         String
  side              String
  basis             String
  rateBps           Int?               @map("rate_bps")
  fixedMinor        BigInt?            @map("fixed_minor")
  appliesTo         String             @default("PRINCIPAL") @map("applies_to")
  operatorCode      String?            @map("operator_code")
  jurisdiction      String?
  category          String?
  saleMethodCode    String?            @map("sale_method_code")
  minPrincipalMinor BigInt?            @map("min_principal_minor")
  maxPrincipalMinor BigInt?            @map("max_principal_minor")
  verification      ConfigVerification @default(draft)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([code, version])
  @@index([active, component])
  @@map("fee_rule")
}

// Persisted charge breakdown snapshot (Evolution E8; reproducibility, pack doc 10). Append-only
// record of a computed breakdown with the per-line applied rules (JSON), so an old transaction is
// reproducible after rules change.
model FeeBreakdown {
  id                    String   @id
  status                String
  currency              String
  principalMinor        BigInt   @map("principal_minor")
  buyerFeesMinor        BigInt   @map("buyer_fees_minor")
  taxMinor              BigInt   @map("tax_minor")
  buyerTotalMinor       BigInt   @map("buyer_total_minor")
  sellerCommissionMinor BigInt   @map("seller_commission_minor")
  sellerProceedsMinor   BigInt   @map("seller_proceeds_minor")
  lines                 Json?
  input                 Json?
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("fee_breakdown")
}

// Payment route (Evolution E8b, pack doc 10). Operator-specific REGULATED route config — references
// an external provider (never an internal ledger/escrow). Deterministically resolved; an unverified
// route is a non-binding preview (owner O4). `providerKind` is always an external/regulated kind.
model PaymentRoute {
  id              String             @id
  code            String
  version         Int                @default(1)
  priority        Int                @default(0)
  active          Boolean            @default(true)
  provider        String
  providerKind    String             @map("provider_kind")
  instructionsRef String?            @map("instructions_ref")
  operatorCode    String             @map("operator_code")
  currency        String?
  jurisdiction    String?
  saleMethodCode  String?            @map("sale_method_code")
  purpose         String?
  verification    ConfigVerification @default(draft)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@unique([code, version])
  @@index([operatorCode, active])
  @@map("payment_route")
}

// Persisted payment-routing intent snapshot (Evolution E8b). Append-only record of a resolved
// route for a transaction — NOT money movement (Singha holds no internal balance); settlement
// happens on the external regulated provider.
model PaymentIntent {
  id                       String   @id
  status                   String
  operatorCode             String   @map("operator_code")
  currency                 String
  purpose                  String
  amountMinor              BigInt?  @map("amount_minor")
  routeCode                String?  @map("route_code")
  provider                 String?
  providerKind             String?  @map("provider_kind")
  requiresManualSettlement Boolean  @default(true) @map("requires_manual_settlement")
  reason                   String?
  input                    Json?
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("payment_intent")
}

// Idempotent, signed webhook intake (Evolution E8b). A UNIQUE (provider, eventId) makes provider
// callbacks idempotent — a replayed event is a no-op.
model PaymentWebhookEvent {
  id          String   @id
  provider    String
  eventId     String   @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([provider, eventId])
  @@map("payment_webhook_event")
}

// Procurement request (Evolution E9, pack doc 09) — the buyer-initiated "I NEED SOMETHING TO BUY"
// side: RFQ / Request-Supply / reverse-tender. Suppliers respond with proposals; the buyer awards
// ONE explicitly (matching never auto-awards). `type`/`status` follow the domain taxonomy.
model ProcurementRequest {
  id                 String    @id
  type               String
  status             String    @default("open")
  title              String
  category           String?
  specification      String?
  quantity           Decimal?  @db.Decimal(38, 9)
  quantityUnitCode   String?   @map("quantity_unit_code")
  destinationCountry String?   @map("destination_country")
  deliveryBy         DateTime? @map("delivery_by")
  currency           String    @default("LKR")
  paymentTerms       String?   @map("payment_terms")
  operatorCode       String?   @map("operator_code")
  buyerCustomerId    String?   @map("buyer_customer_id")
  submissionCloseAt  DateTime? @map("submission_close_at")
  awardedProposalId  String?   @map("awarded_proposal_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  proposals ProcurementProposal[]

  @@index([status])
  @@map("procurement_request")
}

// A supplier's proposal to a procurement request (Evolution E9). The commercial bundle mirrors an
// E4 offer revision (total/unit price in minor units, quantity Decimal, Incoterm, delivery, payment,
// validity). Append-only per supplier submission.
model ProcurementProposal {
  id                 String    @id
  requestId          String    @map("request_id")
  supplierCustomerId String?   @map("supplier_customer_id")
  status             String    @default("open")
  totalPriceMinor    BigInt?   @map("total_price_minor")
  unitPriceMinor     BigInt?   @map("unit_price_minor")
  currency           String    @default("LKR")
  quantity           Decimal?  @db.Decimal(38, 9)
  quantityUnitCode   String?   @map("quantity_unit_code")
  incoterm           String?
  deliveryDate       DateTime? @map("delivery_date")
  paymentTerms       String?   @map("payment_terms")
  validUntil         DateTime? @map("valid_until")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")

  request ProcurementRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("procurement_proposal")
}

// Supply Programme (Evolution E10, pack doc 09 §Supply Programme + owner req 23). A commodity
// supplier's recurring availability — posted once instead of re-listing. Matching against buyer
// demand recommends counterparties but never auto-awards (§09 / D4). Money is integer minor units;
// quantities are Decimal(38,9).
model SupplyProgramme {
  id                   String    @id
  supplierCustomerId   String?   @map("supplier_customer_id")
  product              String
  category             String?
  originCountry        String?   @map("origin_country")
  availableQuantity    Decimal?  @map("available_quantity") @db.Decimal(38, 9)
  quantityUnitCode     String?   @map("quantity_unit_code")
  frequency            String?
  minOrderQuantity     Decimal?  @map("min_order_quantity") @db.Decimal(38, 9)
  maxOrderQuantity     Decimal?  @map("max_order_quantity") @db.Decimal(38, 9)
  pricingBasis         String?   @map("pricing_basis")
  indicativePriceMinor BigInt?   @map("indicative_price_minor")
  currency             String    @default("LKR")
  packing              String?
  quality              String?
  incoterm             String?
  validFrom            DateTime? @map("valid_from")
  validUntil           DateTime? @map("valid_until")
  leadTimeDays         Int?      @map("lead_time_days")
  operatorCode         String?   @map("operator_code")
  status               String    @default("draft")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([category])
  @@map("supply_programme")
}

// Perishable-goods specialist metadata (Evolution E10, owner req 24). Attaches to a listing or a
// supply programme via (subjectType, subjectId) — additive, so the Listing table is never mutated.
// expiryDate / shipmentWindowEnd drive automatic expiry. Temperatures may be negative; moisture is a
// percentage 0–100.
model PerishableMetadata {
  id                  String    @id
  subjectType         String    @map("subject_type")
  subjectId           String    @map("subject_id")
  harvestDate         DateTime? @map("harvest_date")
  packingDate         DateTime? @map("packing_date")
  expiryDate          DateTime? @map("expiry_date")
  variety             String?
  grade               String?
  size                String?
  moisturePercent     Decimal?  @map("moisture_percent") @db.Decimal(6, 3)
  qualitySpec         String?   @map("quality_spec")
  coldChain           Boolean   @default(false) @map("cold_chain")
  tempMinC            Decimal?  @map("temp_min_c") @db.Decimal(6, 2)
  tempMaxC            Decimal?  @map("temp_max_c") @db.Decimal(6, 2)
  phytosanitaryCert   Boolean   @default(false) @map("phytosanitary_cert")
  originCert          Boolean   @default(false) @map("origin_cert")
  availableQuantity   Decimal?  @map("available_quantity") @db.Decimal(38, 9)
  minQuantity         Decimal?  @map("min_quantity") @db.Decimal(38, 9)
  shipmentWindowStart DateTime? @map("shipment_window_start")
  shipmentWindowEnd   DateTime? @map("shipment_window_end")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([subjectType, subjectId])
  @@map("perishable_metadata")
}

// Singha ID profile (Evolution E11, pack doc 11 §Singha ID). One geography-neutral profile extends
// the existing Customer 1:1 (additive — the customer table is never mutated). Preferences only; no
// country-specific accounts.
model CustomerProfile {
  id                String   @id
  customerId        String   @unique @map("customer_id")
  countryResidency  String?  @map("country_residency")
  displayCurrency   String?  @map("display_currency")
  language          String?
  timezone          String?
  companyRoles      Json?    @map("company_roles")
  notificationPrefs Json?    @map("notification_prefs")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("customer_profile")
}

// Capability-based verification grant (Evolution E11). A member requests a capability; an operator
// decides it (O7 governs the evidence bar). A gated activity requires a verified, unexpired grant.
model CustomerCapability {
  id                  String    @id
  customerId          String    @map("customer_id")
  capability          String
  status              String    @default("pending")
  evidenceRef         String?   @map("evidence_ref")
  decidedByCustomerId String?   @map("decided_by_customer_id")
  verifiedAt          DateTime? @map("verified_at")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([customerId, capability])
  @@index([customerId])
  @@map("customer_capability")
}

// Intelligence report (Evolution E12, pack doc 12 §AI). An append-only, derived, NON-BINDING snapshot
// of a deterministic intelligence computation (match / offer comparison / price comparables / risk).
// Derived records never overwrite facts (rule 3); nothing here binds a transaction (rule 11 / doc 12).
model IntelligenceReport {
  id                    String   @id
  kind                  String
  requestedByCustomerId String?  @map("requested_by_customer_id")
  subjectRef            String?  @map("subject_ref")
  result                Json
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([kind])
  @@map("intelligence_report")
}

// Node origination audit (Evolution E13, Addendum A). An append-only attribution + routing snapshot
// of a Satellite Market Node origination attempt. This is deliberately NOT a per-country ledger of
// listings/offers/bids/sales/payments/shipments — those remain the single central canonical records.
// It records origin_node + the resolved outcome for audit (Addendum A acceptance).
model NodeOrigination {
  id           String   @id
  nodeCode     String   @map("node_code")
  capability   String
  outcome      String
  operatorCode String?  @map("operator_code")
  subjectRef   String?  @map("subject_ref")
  requestedBy  String?  @map("requested_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([nodeCode])
  @@map("node_origination")
}

// ---------------------------------------------------------------------------
// Seller persistence (directive §25 / §7) — server-authoritative seller drafts
// and requested auction settings. UI is never the source of truth: these follow
// the seller across devices and (for auction prefs) become a staff-approvable
// request before the authoritative auction is created.
// ---------------------------------------------------------------------------

enum SellerDraftStatus {
  active
  submitted
  archived
}

/// A resumable, server-owned Listing Studio draft (directive §25). Payload is the
/// wizard state; `version` powers optimistic-concurrency conflict handling.
model SellerListingDraft {
  id            String            @id
  ownerId       String            @map("owner_id")
  schemaVersion Int               @default(1) @map("schema_version")
  version       Int               @default(1)
  status        SellerDraftStatus @default(active)
  title         String?
  payload       Json
  mediaState    Json?             @map("media_state")
  aiProvenance  Json?             @map("ai_provenance")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  owner Customer @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@map("seller_listing_draft")
}

enum SellerAuctionPrefStatus {
  requested
  approved
  rejected
  superseded
}

/// A seller's requested auction settings for one listing (directive §7). Persisted
/// structurally (not a UI note) so staff can approve/adjust before the authoritative
/// Auction is configured. Never itself the live auction.
model SellerAuctionPreference {
  id               String                  @id
  listingId        String                  @unique @map("listing_id")
  ownerId          String                  @map("owner_id")
  openingBidMinor  BigInt?                 @map("opening_bid_minor")
  reserveMinor     BigInt?                 @map("reserve_minor")
  incrementMinor   BigInt?                 @map("increment_minor")
  currency         String?
  preferredOpenAt  DateTime?               @map("preferred_open_at")
  preferredCloseAt DateTime?               @map("preferred_close_at")
  notes            String?
  status           SellerAuctionPrefStatus @default(requested)
  reviewedBy       String?                 @map("reviewed_by")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
  @@map("seller_auction_preference")
}

enum InspectionEvidenceStatus {
  requested
  scheduled
  in_progress
  completed
  failed
}

/// Third-party inspection / certification EVIDENCE for an asset (directive §20; RW9,
/// matrix PRV-3). A DERIVED trust record that informs a listing — never an authoritative
/// overwrite of the asset's facts (rule 3) and never binding on a sale. The original
/// certificate document flows through the RW3 secure media pipeline (scanned +
/// access-controlled) and is linked here by `mediaObjectId`; only PUBLIC evidence is ever
/// projected to customers. Additive + all-nullable-where-safe so existing assets stay valid.
model AssetInspectionEvidence {
  id             String                   @id
  assetId        String                   @map("asset_id")
  // InspectionKind from the provider port (gem_certification / vehicle_inspection /
  // machinery_inspection / assay / general). String (not enum) to stay additive as new
  // inspection types appear without a migration; validated by the command schema.
  kind           String
  provider       String
  status         InspectionEvidenceStatus @default(requested)
  // The lab/inspector's own certificate reference — stored, never fabricated (rule 3).
  certificateRef String?                  @map("certificate_ref")
  // The provider-port inspection id (present when requested via the InspectionProvider seam).
  inspectionId   String?                  @map("inspection_id")
  // Customer-safe short outcome summary (e.g. "Grade A, no structural damage").
  summary        String?
  inspectedAt    DateTime?                @map("inspected_at")
  // public → shown on the lot; private/internal → staff-only (never leaks to customers).
  visibility     String                   @default("private")
  // Optional link to the certificate document in the secure media pipeline.
  mediaObjectId  String?                  @map("media_object_id")
  createdBy      String?                  @map("created_by")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  asset       Asset        @relation(fields: [assetId], references: [id])
  mediaObject MediaObject? @relation(fields: [mediaObjectId], references: [id])

  @@index([assetId])
  @@index([assetId, visibility])
  @@map("asset_inspection_evidence")
}
